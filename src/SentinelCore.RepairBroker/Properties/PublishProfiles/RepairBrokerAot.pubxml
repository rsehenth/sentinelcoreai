<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <StripSymbols>true</StripSymbols>
    <SentinelCoreRealTweaks>false</SentinelCoreRealTweaks>
    <SentinelCoreRealRepairs>false</SentinelCoreRealRepairs>
    <SentinelCoreRealDebloat>false</SentinelCoreRealDebloat>
    <PublishDir>$(MSBuildProjectDirectory)/../../artifacts/packaging/repair-broker/aot/</PublishDir>
  </PropertyGroup>
</Project>
