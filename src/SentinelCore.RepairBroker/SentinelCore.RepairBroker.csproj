<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SentinelCore.Application/SentinelCore.Application.csproj" />
    <ProjectReference Include="../SentinelCore.Infrastructure.Repairs/SentinelCore.Infrastructure.Repairs.csproj" />
  </ItemGroup>
  <Target Name="RequireClosedBrokerPackaging" BeforeTargets="PrepareForPublish" Condition="'$(PublishAot)' == 'true'">
    <Error Condition="'$(SentinelCoreRealTweaks)' != 'false' or '$(SentinelCoreRealRepairs)' != 'false' or '$(SentinelCoreRealDebloat)' != 'false'"
           Text="Empacotamento do broker nesta fase exige todos os gates de build fechados." />
  </Target>
</Project>
