<UserControl x:Class="SentinelCore.App.RecoveryCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI"
             Loaded="OnLoaded" Unloaded="OnUnloaded"
             AutomationProperties.AutomationId="RecoveryCenterView" AutomationProperties.Name="{DynamicResource T93}">
    <UserControl.Resources>
        <Style x:Key="RecoveryReadout" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="RecoveryCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
        <Style x:Key="RecoveryFilter" TargetType="StackPanel">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="RowBackground" Value="{DynamicResource Surface}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Sidebar}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="RecoveryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,28,32,24">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{DynamicResource PageIcon}"><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Data="{DynamicResource IconHistory}" Stroke="{DynamicResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource T93}" Style="{DynamicResource PageTitle}"/>
                        <TextBlock Text="{DynamicResource T250}" Style="{DynamicResource PageSubtitle}"/>
                    </StackPanel>
                </Grid>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="{DynamicResource T46}" Tag="{DynamicResource IconRefresh}" Click="OnRefresh" Margin="16,0,0,0" VerticalAlignment="Top" AutomationProperties.AutomationId="RecoveryRefresh"/>
            </Grid>
            <Border Style="{DynamicResource Card}" Padding="16" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock x:Name="ModeText" Text="{DynamicResource T114}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="{DynamicResource T215}" Style="{DynamicResource Caption}" Margin="0,6,0,0"/>
                    <TextBlock Text="{DynamicResource T447}" Style="{DynamicResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="SummaryText" Text="{DynamicResource T251}" Margin="0,16,0,8" Foreground="{DynamicResource Muted}" AutomationProperties.AutomationId="RecoverySummary" AutomationProperties.LiveSetting="Polite"/>
            <Expander x:Name="AuditInterruptionsPanel" Header="{DynamicResource T55}" Visibility="Collapsed" Margin="0,0,0,12">
                <StackPanel Margin="12,8">
                    <TextBlock x:Name="AuditInterruptionsSummary" Style="{DynamicResource Caption}" TextWrapping="Wrap"/>
                    <ListBox x:Name="AuditInterruptionsList" MaxHeight="180" Margin="0,8,0,0"
                             AutomationProperties.Name="{DynamicResource T229}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Click="OnOpenInterruptedAudit" Style="{DynamicResource CompactButton}"
                                        AutomationProperties.Name="{Binding Label}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Expander>
            <ItemsControl x:Name="SummaryCards" AutomationProperties.AutomationId="RecoveryCounters">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Style="{DynamicResource Card}" Padding="14,10" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{DynamicResource Caption}"/>
                            <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Detail}" Style="{DynamicResource Caption}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="WarningsPanel" Visibility="Collapsed" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,4,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource T245}" Foreground="{DynamicResource Warn}" FontWeight="SemiBold"/>
                    <TextBox x:Name="WarningsText" AutomationProperties.Name="{DynamicResource T64}" Style="{StaticResource RecoveryReadout}" MaxHeight="180" Margin="0,8,0,0" AutomationProperties.AutomationId="RecoveryWarnings"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{DynamicResource T297}" Style="{DynamicResource PaneTitle}" Margin="0,8,0,8"/>
            <TextBox x:Name="SearchText" Style="{DynamicResource SearchBox}" TextChanged="OnFilterChanged" AutomationProperties.Name="{DynamicResource T76}" AutomationProperties.AutomationId="RecoverySearch" ToolTip="{DynamicResource T67}"/>
            <WrapPanel Margin="0,12,0,0">
                <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="{DynamicResource T309}" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="ModuleCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{DynamicResource T309}"/></StackPanel>
                <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="{DynamicResource T409}" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="OutcomeCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{DynamicResource T409}"/></StackPanel>
                <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="{DynamicResource T341}" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="OriginCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{DynamicResource T344}"/></StackPanel>
                <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="{DynamicResource T383}" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="CapabilityCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{DynamicResource T83}"/></StackPanel>
            </WrapPanel>
            <Expander Header="{DynamicResource T300}" IsExpanded="False" Foreground="{DynamicResource Text}" Margin="0,0,0,10" AutomationProperties.Name="{DynamicResource T301}">
                <WrapPanel Margin="0,12,0,0">
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="{DynamicResource T456}" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="TypeCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{DynamicResource T458}"/></StackPanel>
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="{DynamicResource T184}" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="StateCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{DynamicResource T184}"/></StackPanel>
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="{DynamicResource T416}" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="RiskCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{DynamicResource T416}"/></StackPanel>
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="{DynamicResource T162}" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="AvailableCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{DynamicResource T385}"/></StackPanel>
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="{DynamicResource T112}" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="ConflictCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{DynamicResource T112}"/></StackPanel>
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="{DynamicResource T269}" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="InterventionCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{DynamicResource T269}"/></StackPanel>
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="{DynamicResource T130}" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><DatePicker x:Name="FromDate" SelectedDateChanged="OnFilterChanged" AutomationProperties.Name="{DynamicResource T128}"/></StackPanel>
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="{DynamicResource T42}" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><DatePicker x:Name="ToDate" SelectedDateChanged="OnFilterChanged" AutomationProperties.Name="{DynamicResource T127}"/></StackPanel>
                </WrapPanel>
            </Expander>
            <Button x:Name="ClearFiltersButton" Content="{DynamicResource T292}" Click="OnClearFilters" HorizontalAlignment="Left" Style="{DynamicResource GhostButton}" Margin="0,0,0,10"/>
            <TextBlock x:Name="HistorySummary" Text="{DynamicResource T323}" Style="{DynamicResource Caption}" Margin="0,0,0,8" AutomationProperties.AutomationId="RecoveryHistorySummary"/>
            <DataGrid x:Name="HistoryGrid" Height="300" HorizontalScrollBarVisibility="Auto" SelectionChanged="OnSelectionChanged" AutomationProperties.AutomationId="RecoveryHistory" AutomationProperties.Name="{DynamicResource T248}">
                <DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="{DynamicResource T129}" Binding="{Binding LocalDate}" SortMemberPath="Operation.AtUtc" Width="1.1*" MinWidth="84"/>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="{DynamicResource T309}" Binding="{Binding Module}" Width="1*" MinWidth="84"/>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="{DynamicResource T341}" Binding="{Binding Origin}" Width="1*" MinWidth="84"/>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="{DynamicResource T336}" Binding="{Binding Operation.OperationId}" Width="1.3*" MinWidth="84"/>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="{DynamicResource T33}" Binding="{Binding Operation.Target}" Width="1.5*" MinWidth="84"/>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="{DynamicResource T181}" Binding="{Binding StateText}" Width="1.1*" MinWidth="84"/>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="{DynamicResource T409}" Binding="{Binding Outcome}" Width="1.1*" MinWidth="84"/>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="{DynamicResource T383}" Binding="{Binding Capability}" Width="1.4*" MinWidth="84"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Style="{DynamicResource Card}" Padding="18" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock x:Name="DetailsTitle" Text="{DynamicResource T145}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource T255}" Style="{DynamicResource Caption}" Margin="0,5,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="DetailsText" Style="{StaticResource RecoveryReadout}" Height="280" Text="{DynamicResource T432}" AutomationProperties.AutomationId="RecoveryDetails" AutomationProperties.Name="{DynamicResource T147}"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource T195}" Style="{DynamicResource PaneTitle}" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource T449}" Style="{DynamicResource Caption}" Margin="0,0,0,8"/>
                            <TextBox x:Name="TimelineText" Style="{StaticResource RecoveryReadout}" Height="212" Text="{DynamicResource T315}" AutomationProperties.AutomationId="RecoveryTimeline" AutomationProperties.Name="{DynamicResource T196}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource T295}" Style="{DynamicResource Caption}" Margin="0,14,0,5"/>
                    <TextBox x:Name="ReportPathText" Style="{StaticResource RecoveryReadout}" AutomationProperties.Name="{DynamicResource T296}"/>
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card}" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource T384}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RecoveryPolicyText" Text="{DynamicResource T201}" Style="{DynamicResource Caption}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ConfirmationHint" Text="{DynamicResource T425}" Style="{DynamicResource Caption}" Margin="0,10,0,6"/>
                    <TextBox x:Name="ConfirmationText" IsEnabled="False" TextChanged="OnConfirmationChanged" AutomationProperties.AutomationId="RecoveryConfirmation" AutomationProperties.Name="{DynamicResource T107}"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="AnalyzeButton" Content="{DynamicResource T35}" IsEnabled="False" Click="OnAnalyze" Margin="0,0,10,8" AutomationProperties.AutomationId="RecoveryAnalyze"/>
                        <Button x:Name="RecoverButton" Content="{DynamicResource T110}" IsEnabled="False" Click="OnRecover" Margin="0,0,0,8" AutomationProperties.AutomationId="RecoveryExecuteSynthetic"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" Text="{DynamicResource T32}" Margin="0,14,0,0" AutomationProperties.AutomationId="RecoveryStatus" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{DynamicResource T115}" Style="{DynamicResource FootNote}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
