<UserControl x:Class="SentinelCore.App.RecoveryCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI"
             Loaded="OnLoaded" Unloaded="OnUnloaded"
             AutomationProperties.AutomationId="RecoveryCenterView" AutomationProperties.Name="Central de Recuperação">
    <UserControl.Resources>
        <Style x:Key="RecoveryReadout" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="RecoveryCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
        <Style x:Key="RecoveryFilter" TargetType="StackPanel">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="RowBackground" Value="{DynamicResource Surface}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Sidebar}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="RecoveryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,28,32,24">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{DynamicResource PageIcon}"><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Data="{DynamicResource IconHistory}" Stroke="{DynamicResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Central de Recuperação" Style="{DynamicResource PageTitle}"/>
                        <TextBlock Text="Histórico, consequências e possibilidades de recuperação dos módulos locais." Style="{DynamicResource PageSubtitle}"/>
                    </StackPanel>
                </Grid>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="Atualizar histórico" Tag="{DynamicResource IconRefresh}" Click="OnRefresh" Margin="16,0,0,0" VerticalAlignment="Top" AutomationProperties.AutomationId="RecoveryRefresh"/>
            </Grid>
            <Border Style="{DynamicResource Card}" Padding="16" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock x:Name="ModeText" Text="Consulta local — execução real bloqueada" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="Fixtures são identificadas como sintéticas. Origem não registrada permanece desconhecida. Debloat e reparos não possuem rollback equivalente aos Tweaks." Style="{DynamicResource Caption}" Margin="0,6,0,0"/>
                    <TextBlock Text="Snapshots de aplicativos preservam metadados; não recuperam configurações, licenças, contas ou dados pessoais." Style="{DynamicResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="SummaryText" Text="Históricos ainda não carregados. Contagens indisponíveis." Margin="0,16,0,8" Foreground="{DynamicResource Muted}" AutomationProperties.AutomationId="RecoverySummary" AutomationProperties.LiveSetting="Polite"/>
            <Expander x:Name="AuditInterruptionsPanel" Header="Auditorias e interrupções" Visibility="Collapsed" Margin="0,0,0,12">
                <StackPanel Margin="12,8">
                    <TextBlock x:Name="AuditInterruptionsSummary" Style="{DynamicResource Caption}" TextWrapping="Wrap"/>
                    <ListBox x:Name="AuditInterruptionsList" MaxHeight="180" Margin="0,8,0,0"
                             AutomationProperties.Name="Histórico de auditorias e interrupções">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Click="OnOpenInterruptedAudit" Style="{DynamicResource CompactButton}"
                                        AutomationProperties.Name="{Binding Label}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Expander>
            <ItemsControl x:Name="SummaryCards" AutomationProperties.AutomationId="RecoveryCounters">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Style="{DynamicResource Card}" Padding="14,10" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{DynamicResource Caption}"/>
                            <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Detail}" Style="{DynamicResource Caption}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="WarningsPanel" Visibility="Collapsed" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,4,0,16">
                <StackPanel>
                    <TextBlock Text="Histórico incompleto ou com limitações" Foreground="{DynamicResource Warn}" FontWeight="SemiBold"/>
                    <TextBox x:Name="WarningsText" AutomationProperties.Name="Avisos da Central de Recuperação" Style="{StaticResource RecoveryReadout}" MaxHeight="180" Margin="0,8,0,0" AutomationProperties.AutomationId="RecoveryWarnings"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Localizar operações" Style="{DynamicResource PaneTitle}" Margin="0,8,0,8"/>
            <TextBox x:Name="SearchText" Style="{DynamicResource SearchBox}" TextChanged="OnFilterChanged" AutomationProperties.Name="Buscar por identificação, alvo ou informações do histórico" AutomationProperties.AutomationId="RecoverySearch" ToolTip="Busca textual nos registros carregados"/>
            <WrapPanel Margin="0,12,0,0">
                <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="Módulo" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="ModuleCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Módulo"/></StackPanel>
                <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="Resultado" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="OutcomeCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Resultado"/></StackPanel>
                <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="Origem" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="OriginCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Origem sintética, real ou desconhecida"/></StackPanel>
                <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="Recuperação" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="CapabilityCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Capacidade de recuperação"/></StackPanel>
            </WrapPanel>
            <Expander Header="Mais filtros" IsExpanded="False" Foreground="{DynamicResource Text}" Margin="0,0,0,10" AutomationProperties.Name="Mais filtros de histórico">
                <WrapPanel Margin="0,12,0,0">
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="Tipo" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="TypeCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Tipo de operação"/></StackPanel>
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="Estado registrado" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="StateCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Estado registrado"/></StackPanel>
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="Risco" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="RiskCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Risco"/></StackPanel>
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="Disponibilidade de recuperação" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="AvailableCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Recuperação disponível ou indisponível"/></StackPanel>
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="Conflito" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="ConflictCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Conflito"/></StackPanel>
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="Intervenção necessária" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="InterventionCombo" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Intervenção necessária"/></StackPanel>
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="De (data local)" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><DatePicker x:Name="FromDate" SelectedDateChanged="OnFilterChanged" AutomationProperties.Name="Data inicial no fuso local"/></StackPanel>
                    <StackPanel Style="{StaticResource RecoveryFilter}"><TextBlock Text="Até (data local)" Style="{DynamicResource Caption}" Margin="0,0,0,5"/><DatePicker x:Name="ToDate" SelectedDateChanged="OnFilterChanged" AutomationProperties.Name="Data final no fuso local"/></StackPanel>
                </WrapPanel>
            </Expander>
            <Button x:Name="ClearFiltersButton" Content="Limpar filtros" Click="OnClearFilters" HorizontalAlignment="Left" Style="{DynamicResource GhostButton}" Margin="0,0,0,10"/>
            <TextBlock x:Name="HistorySummary" Text="Nenhuma fonte carregada." Style="{DynamicResource Caption}" Margin="0,0,0,8" AutomationProperties.AutomationId="RecoveryHistorySummary"/>
            <DataGrid x:Name="HistoryGrid" Height="300" HorizontalScrollBarVisibility="Auto" SelectionChanged="OnSelectionChanged" AutomationProperties.AutomationId="RecoveryHistory" AutomationProperties.Name="Histórico unificado de operações">
                <DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="Data local" Binding="{Binding LocalDate}" SortMemberPath="Operation.AtUtc" Width="1.1*" MinWidth="84"/>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="Módulo" Binding="{Binding Module}" Width="1*" MinWidth="84"/>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="Origem" Binding="{Binding Origin}" Width="1*" MinWidth="84"/>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="Operação" Binding="{Binding Operation.OperationId}" Width="1.3*" MinWidth="84"/>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="Alvo" Binding="{Binding Operation.Target}" Width="1.5*" MinWidth="84"/>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="Estado" Binding="{Binding StateText}" Width="1.1*" MinWidth="84"/>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="Resultado" Binding="{Binding Outcome}" Width="1.1*" MinWidth="84"/>
                    <DataGridTextColumn ElementStyle="{StaticResource RecoveryCell}" Header="Recuperação" Binding="{Binding Capability}" Width="1.4*" MinWidth="84"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Style="{DynamicResource Card}" Padding="18" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock x:Name="DetailsTitle" Text="Detalhes da operação" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Identificação, estado, consequências, proteções, recuperação e próximas ações. Informação ausente permanece indisponível." Style="{DynamicResource Caption}" Margin="0,5,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="DetailsText" Style="{StaticResource RecoveryReadout}" Height="280" Text="Selecione uma operação do histórico." AutomationProperties.AutomationId="RecoveryDetails" AutomationProperties.Name="Detalhes da operação selecionada"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Eventos persistidos" Style="{DynamicResource PaneTitle}" Margin="0,0,0,4"/>
                            <TextBlock Text="Somente eventos existentes, em ordem temporal. Uma intenção não comprova início de execução." Style="{DynamicResource Caption}" Margin="0,0,0,8"/>
                            <TextBox x:Name="TimelineText" Style="{StaticResource RecoveryReadout}" Height="212" Text="Nenhum evento selecionado." AutomationProperties.AutomationId="RecoveryTimeline" AutomationProperties.Name="Eventos persistidos da operação"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Localização do relatório" Style="{DynamicResource Caption}" Margin="0,14,0,5"/>
                    <TextBox x:Name="ReportPathText" Style="{StaticResource RecoveryReadout}" AutomationProperties.Name="Localização do relatório, somente leitura"/>
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card}" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Recuperação de Tweaks" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RecoveryPolicyText" Text="Execução bloqueada nesta composição. A central não consulta o estado atual do Registro nem executa rollback real." Style="{DynamicResource Caption}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ConfirmationHint" Text="Selecione um alvo sintético suportado para analisar a recuperação." Style="{DynamicResource Caption}" Margin="0,10,0,6"/>
                    <TextBox x:Name="ConfirmationText" IsEnabled="False" TextChanged="OnConfirmationChanged" AutomationProperties.AutomationId="RecoveryConfirmation" AutomationProperties.Name="Confirmação específica de recuperação"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="AnalyzeButton" Content="Analisar recuperação" IsEnabled="False" Click="OnAnalyze" Margin="0,0,10,8" AutomationProperties.AutomationId="RecoveryAnalyze"/>
                        <Button x:Name="RecoverButton" Content="Confirmar recuperação" IsEnabled="False" Click="OnRecover" Margin="0,0,0,8" AutomationProperties.AutomationId="RecoveryExecuteSynthetic"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" Text="Aguardando leitura do histórico local." Margin="0,14,0,0" AutomationProperties.AutomationId="RecoveryStatus" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="Consulta não executa reparos, remoções ou reinstalações. Conflitos e bloqueios persistentes não podem ser ignorados. A validação real permanece pendente." Style="{DynamicResource FootNote}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
