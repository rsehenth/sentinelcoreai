<UserControl x:Class="SentinelCore.App.AppsStartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SentinelCore.App"
             FontFamily="Segoe UI" Foreground="{DynamicResource Text}"
             Loaded="OnLoaded"
             AutomationProperties.AutomationId="AppsStartupView">
    <UserControl.Resources>
        <!-- DataGrid/cabeçalho/célula vêm do estilo único de App.xaml. Aqui só o que é específico do módulo. -->
        <Style x:Key="AppsReadout" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Height" Value="170"/><Setter Property="Padding" Value="14"/>
        </Style>
        <!-- Estado e operação aparecem sempre como texto; a cor só reforça (verde = elegível, âmbar = não verificado/indisponível). -->
        <Style x:Key="EligibilityCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Eligibility.Eligibility}" Value="Eligible"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
                <DataTrigger Binding="{Binding Eligibility.Eligibility}" Value="Unavailable"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
                <DataTrigger Binding="{Binding Eligibility.Eligibility}" Value="ReadOnly"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Entry.State}" Value="Unknown"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
                <DataTrigger Binding="{Binding Entry.State}" Value="Disabled"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RuntimeCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Entry.Runtime}" Value="NotVerified"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <!-- Faixa de modo demonstrativo: sempre visível enquanto os dados forem sintéticos e os gates estiverem fechados. -->
        <Border Style="{DynamicResource Card}" Padding="14,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{DynamicResource StatusPill}" VerticalAlignment="Top" Margin="0,0,14,0" AutomationProperties.AutomationId="AppsStartupDemoBadge">
                    <TextBlock x:Name="DemoBadgeText" Foreground="{DynamicResource Warn}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="GateText" Style="{DynamicResource Caption}" TextWrapping="Wrap" AutomationProperties.AutomationId="AppsStartupGateMessage"/>
                    <TextBlock x:Name="OriginText" Style="{DynamicResource FootNote}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <WrapPanel Margin="0,0,0,10"> <Button x:Name="RefreshButton" Style="{DynamicResource CompactButton}" Tag="{DynamicResource IconRefresh}" Margin="0,0,10,6" Click="OnRefresh"
                    AutomationProperties.AutomationId="RefreshAppsStartup"/>
            <TextBlock x:Name="StatusText" Style="{DynamicResource Caption}" VerticalAlignment="Center" Margin="0,0,0,6" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="AppsStartupStatus"/>
        </WrapPanel>
        <TextBlock x:Name="WarningText" Style="{DynamicResource Caption}" Foreground="{DynamicResource Warn}" Visibility="Collapsed" Margin="0,0,0,6" TextWrapping="Wrap"/>

        <TabControl x:Name="InnerTabs" Margin="0,4,0,0" AutomationProperties.AutomationId="AppsStartupTabs">
            <!-- ABA A — Inicialização do Windows -->
            <TabItem x:Name="StartupTab">
                <StackPanel Margin="0,16,0,0"> <TextBlock x:Name="StartupHint" Style="{DynamicResource Caption}" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock x:Name="StartupSearchLabel" Style="{DynamicResource Caption}" Margin="0,0,0,4"/>
                            <TextBox x:Name="StartupSearch" Width="222" Style="{DynamicResource SearchBox}" TextChanged="OnFilterChanged"
                                     AutomationProperties.AutomationId="StartupSearch"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock x:Name="StartupSourceLabel" Style="{DynamicResource Caption}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="StartupSourceCombo" Width="210" SelectionChanged="OnFilterChanged" AutomationProperties.AutomationId="StartupSourceFilter"
                                      AutomationProperties.LabeledBy="{Binding ElementName=StartupSourceLabel}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock x:Name="StartupStateLabel" Style="{DynamicResource Caption}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="StartupStateCombo" Width="190" SelectionChanged="OnFilterChanged" AutomationProperties.AutomationId="StartupStateFilter"
                                      AutomationProperties.LabeledBy="{Binding ElementName=StartupStateLabel}"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock x:Name="StartupSummary" Style="{DynamicResource Caption}" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
                    <DataGrid x:Name="StartupGrid" Height="300" SelectionChanged="OnStartupSelection" AutomationProperties.AutomationId="StartupGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="StartupColName" Binding="{Binding Name}" Width="2*" MinWidth="170" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn x:Name="StartupColPublisher" Visibility="Collapsed" Binding="{Binding Publisher}" Width="*" MinWidth="110" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn x:Name="StartupColSource" Binding="{Binding Source}" Width="150" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn x:Name="StartupColScope" Visibility="Collapsed" Binding="{Binding Scope}" Width="90" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn x:Name="StartupColState" Binding="{Binding State}" Width="160" ElementStyle="{StaticResource StateCell}"/>
                            <DataGridTextColumn x:Name="StartupColRuntime" Binding="{Binding Runtime}" Width="190" ElementStyle="{StaticResource RuntimeCell}"/>
                            <DataGridTextColumn x:Name="StartupColEligibility" Binding="{Binding EligibilityText}" Width="170" ElementStyle="{StaticResource EligibilityCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox x:Name="StartupDetails" Style="{StaticResource AppsReadout}" Margin="0,12,0,0" AutomationProperties.AutomationId="StartupDetails"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="PreviewDisableButton" Style="{DynamicResource CompactButton}" IsEnabled="False" Margin="0,0,8,6" Click="OnPreviewDisable"
                                AutomationProperties.AutomationId="PreviewStartupDisable"/>
                        <Button x:Name="PreviewEnableButton" Style="{DynamicResource CompactButton}" IsEnabled="False" Margin="0,0,8,6" Click="OnPreviewEnable"
                                AutomationProperties.AutomationId="PreviewStartupEnable"/>
                    </WrapPanel>
                    <TextBox x:Name="StartupPreviewBox" Style="{StaticResource AppsReadout}" Visibility="Collapsed" Margin="0,4,0,0" AutomationProperties.AutomationId="StartupPreview"/>
                    <WrapPanel x:Name="StartupConfirmPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBox x:Name="StartupConfirmBox" Width="400" Style="{DynamicResource SearchBox}" TextChanged="OnConfirmChanged" Margin="0,0,10,6"
                                 AutomationProperties.AutomationId="StartupConfirmation"/>
                        <Button x:Name="StartupExecuteButton" Style="{DynamicResource PrimaryButton}" IsEnabled="False" Click="OnStartupExecute" Margin="0,0,0,6"
                                AutomationProperties.AutomationId="ExecuteStartupChange"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <!-- ABA B — Aplicativos instalados -->
            <TabItem x:Name="AppsTab">
                <StackPanel Margin="0,16,0,0"> <TextBlock x:Name="AppsHint" Style="{DynamicResource Caption}" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock x:Name="AppsSearchLabel" Style="{DynamicResource Caption}" Margin="0,0,0,4"/>
                            <TextBox x:Name="AppsSearch" Width="222" Style="{DynamicResource SearchBox}" TextChanged="OnFilterChanged"
                                     AutomationProperties.AutomationId="AppsSearch"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock x:Name="AppsKindLabel" Style="{DynamicResource Caption}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="AppsKindCombo" Width="190" SelectionChanged="OnFilterChanged" AutomationProperties.AutomationId="AppsKindFilter"
                                      AutomationProperties.LabeledBy="{Binding ElementName=AppsKindLabel}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock x:Name="AppsScopeLabel" Style="{DynamicResource Caption}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="AppsScopeCombo" Width="160" SelectionChanged="OnFilterChanged" AutomationProperties.AutomationId="AppsScopeFilter"
                                      AutomationProperties.LabeledBy="{Binding ElementName=AppsScopeLabel}"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock x:Name="AppsSummary" Style="{DynamicResource Caption}" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
                    <DataGrid x:Name="AppsGrid" Height="300" SelectionChanged="OnAppSelection" AutomationProperties.AutomationId="AppsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="AppsColName" Binding="{Binding Name}" Width="2*" MinWidth="170" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn x:Name="AppsColPublisher" Binding="{Binding Publisher}" Width="*" MinWidth="110" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn x:Name="AppsColVersion" Binding="{Binding Version}" Width="100" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn x:Name="AppsColKind" Binding="{Binding Kind}" Width="150" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn x:Name="AppsColScope" Visibility="Collapsed" Binding="{Binding Scope}" Width="90" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn x:Name="AppsColEligibility" Binding="{Binding EligibilityText}" Width="170" ElementStyle="{StaticResource EligibilityCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox x:Name="AppsDetails" Style="{StaticResource AppsReadout}" Margin="0,12,0,0" AutomationProperties.AutomationId="AppsDetails"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="PreviewUninstallButton" Style="{DynamicResource CompactButton}" IsEnabled="False" Margin="0,0,8,6" Click="OnPreviewUninstall"
                                AutomationProperties.AutomationId="PreviewUninstall"/>
                    </WrapPanel>
                    <TextBox x:Name="UninstallPreviewBox" Style="{StaticResource AppsReadout}" Visibility="Collapsed" Margin="0,4,0,0" AutomationProperties.AutomationId="UninstallPreview"/>
                    <WrapPanel x:Name="UninstallConfirmPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBox x:Name="UninstallConfirmBox" Width="400" Style="{DynamicResource SearchBox}" TextChanged="OnConfirmChanged" Margin="0,0,10,6"
                                 AutomationProperties.AutomationId="UninstallConfirmation"/>
                        <Button x:Name="UninstallExecuteButton" Style="{DynamicResource PrimaryButton}" IsEnabled="False" Click="OnUninstallExecute" Margin="0,0,0,6"
                                AutomationProperties.AutomationId="ExecuteUninstall"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="HistoryTitle" Style="{DynamicResource PaneTitle}" Margin="0,32,0,10"/>
        <DataGrid x:Name="HistoryGrid" Height="180" AutomationProperties.AutomationId="AppsStartupHistory">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="HistColDate" Binding="{Binding Date}" Width="150" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn x:Name="HistColAction" Binding="{Binding Action}" Width="190" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn x:Name="HistColName" Binding="{Binding Name}" Width="*" MinWidth="140" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn x:Name="HistColOrigin" Binding="{Binding Origin}" Width="190" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn x:Name="HistColResult" Binding="{Binding Result}" Width="2*" MinWidth="200" ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="HistoryEmpty" Style="{DynamicResource Caption}" Margin="0,6,0,0"/>
    </StackPanel>
</UserControl>
