                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                <Button x:Name="HardwareReloadButton" Content="{DynamicResource T379}" Tag="{StaticResource IconRefresh}" Style="{StaticResource GhostButton}" Click="OnHardwareReload"
