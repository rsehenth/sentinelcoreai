                            <ComboBox x:Name="EventWindowCombo" AutomationProperties.Name="{DynamicResource T352}" Width="160" SelectionChanged="OnEventWindowChanged" DisplayMemberPath="Label" AutomationProperties.AutomationId="EventWindow"/>
                            <StackPanel x:Name="EventCustomDates" Orientation="Horizontal" Visibility="Collapsed" Margin="12,0,0,0">
                                <DatePicker x:Name="EventFromPicker" Width="140" SelectedDateChanged="OnEventDatesChanged" AutomationProperties.Name="{DynamicResource T266}"/>
                                <TextBlock Text="{DynamicResource T41}" Foreground="{StaticResource Muted}" Margin="10,0" VerticalAlignment="Center"/>
                                <DatePicker x:Name="EventToPicker" Width="140" SelectedDateChanged="OnEventDatesChanged" AutomationProperties.Name="{DynamicResource T213}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,16,0,0">
