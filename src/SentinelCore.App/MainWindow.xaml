                        <TextBlock Grid.Row="4" Style="{StaticResource FootNote}" Margin="0,12,0,0"
                                   Text="{DynamicResource T287}"/>
                    </Grid></Border>
                    </ScrollViewer>
                </TabItem>

                <!-- ───── Estabilidade e Eventos ───── -->
                <TabItem x:Name="EventsTab" Header="{DynamicResource T179}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
