<Window x:Class="SentinelCore.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SentinelCore AI" Width="1320" Height="860" MinWidth="1120" MinHeight="720"
        Icon="Assets/app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnWindowKeyDown">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- ═══════════ Menu lateral ═══════════ -->
        <Border Background="{StaticResource SidebarGradient}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="14,22,14,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,28">
                    <Border Width="40" Height="40" Background="{StaticResource TileGradient}" BorderBrush="#2F6482" BorderThickness="1" CornerRadius="11" Margin="0,0,12,0">
                        <Viewbox Width="22" Height="24">
                            <Canvas Width="44" Height="48">
                                <Path Data="M 22,6 L 36,12 L 34,29 L 22,40 L 10,29 L 8,12 Z M 15,23 L 20,28 L 29,17" Stroke="{StaticResource Accent}"
                                      StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SentinelCore AI" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                        <TextBlock Text="Diagnóstico do Windows" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="NoWrap"/>
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="NavList" Grid.Row="1" SelectedIndex="0" SelectionChanged="OnNavChanged" Padding="0" AutomationProperties.Name="Menu principal"
                         ItemContainerStyle="{StaticResource NavItem}" VerticalAlignment="Top">
                    <ListBoxItem Content="Visão geral" Tag="{StaticResource IconOverview}" ToolTip="Visão geral e auditoria básica (Ctrl+1)"/>
                    <ListBoxItem Content="Resultados" Tag="{StaticResource IconResults}" ToolTip="Evidências por categoria da última auditoria (Ctrl+2)"/>
                    <ListBoxItem Content="Hardware" Tag="{StaticResource IconHardware}" ToolTip="Inventário de hardware (Ctrl+3)"/>
                    <ListBoxItem Content="Estabilidade e Eventos" Tag="{StaticResource IconEvents}" ToolTip="Log de Eventos e relatórios de falha (Ctrl+4)"/>
                    <ListBoxItem Content="Desempenho" Tag="{StaticResource IconPerformance}" ToolTip="Monitoramento de desempenho (Ctrl+5)"/>
                    <ListBoxItem Content="Rede" Tag="{StaticResource IconNetwork}" ToolTip="Diagnóstico de rede somente leitura (Ctrl+6)"/>
                    <ListBoxItem Content="Gráficos &amp; GPU" Tag="{StaticResource IconGraphics}" ToolTip="Diagnóstico gráfico somente leitura (Ctrl+7)"/>
                    <ListBoxItem Content="Correlação" Tag="{StaticResource IconCompare}" ToolTip="Correlação de evidências históricas (Ctrl+8)"/>
                    <ListBoxItem Content="Histórico" Tag="{StaticResource IconHistory}" ToolTip="Auditorias salvas neste computador (Ctrl+9)"/>
                    <ListBoxItem Content="Monitoramento" Tag="{StaticResource IconPerformance}" ToolTip="Sessões de observação autorizadas e registro de incidentes"/>
                    <ListBoxItem Content="Personalização" Tag="{StaticResource IconShieldCheck}" ToolTip="Tweaks controlados em HKCU, com backup e recuperação"/>
                    <ListBoxItem Content="Reparos do Windows" Tag="{StaticResource IconShieldCheck}" ToolTip="Ferramentas oficiais de reparo do Windows em modo de simulação"/>
                </ListBox>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                <Canvas Width="24" Height="24"><Path Data="{StaticResource IconLock}" Stroke="{StaticResource Success}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
                            </Viewbox>
                            <TextBlock Text="Diagnóstico e tweaks controlados" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="Diagnóstico somente leitura. Tweaks exigem plano, autorização, backup e verificação; nada é enviado." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="VersionText" Text="v0.3.0  •  Local e offline" Foreground="{StaticResource Subtle}" FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════ Conteúdo ═══════════ -->
        <Grid Grid.Column="1" Background="{StaticResource WindowGlow}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Border x:Name="WarningBanner" Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnLine}" BorderThickness="1"
                    CornerRadius="10" Padding="14,10" Margin="32,20,32,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="18" Height="18" Margin="0,1,12,0" VerticalAlignment="Top">
                        <Canvas Width="24" Height="24"><Path Data="{StaticResource IconWarning}" Stroke="{StaticResource Warn}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
                    </Viewbox>
                    <TextBlock x:Name="StorageWarnings" Foreground="{StaticResource Warn}" MaxWidth="780"/>
                </StackPanel>
            </Border>

            <TabControl x:Name="Pages" Grid.Row="1" Style="{StaticResource PageHost}"
                        SelectedIndex="{Binding SelectedIndex, ElementName=NavList, Mode=TwoWay}">

                <!-- ───── Visão geral ───── -->
                <TabItem Header="Visão geral">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <Grid Margin="32,28,32,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border CornerRadius="18" Background="{StaticResource HeroGradient}" BorderBrush="#2F5B7E" BorderThickness="1" Padding="30,22" ClipToBounds="True">
                                <Grid>
                                    <Viewbox Width="230" Height="252" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.2" IsHitTestVisible="False">
                                        <Canvas Width="44" Height="48">
                                            <Path Data="M 22,6 L 36,12 L 34,29 L 22,40 L 10,29 L 8,12 Z M 15,23 L 20,28 L 29,17" Stroke="{StaticResource Accent}"
                                                  StrokeThickness="0.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel>
                                        <Border HorizontalAlignment="Left" CornerRadius="13" Background="#0F2B3C" BorderBrush="#2B6078" BorderThickness="1" Padding="11,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="13" Height="13" Margin="0,0,7,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconLock}" Stroke="{StaticResource Success}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                                                <TextBlock Text="Somente leitura · local e offline" FontSize="12" Foreground="#BFE9F3" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Visão geral" FontSize="32" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                        <TextBlock Text="Auditoria básica do Windows e acesso rápido a cada área." Style="{StaticResource PageSubtitle}" Foreground="#A9C4D8" MaxWidth="520" HorizontalAlignment="Left"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                            <Button x:Name="RunButton" Content="Executar auditoria básica" Tag="{StaticResource IconPlay}" Style="{StaticResource PrimaryButton}"
                                                    Click="OnRun" AutomationProperties.AutomationId="RunBasicAudit"/>
                                            <Button x:Name="CancelButton" Content="Cancelar coleta" Tag="{StaticResource IconStop}" Click="OnCancel" IsEnabled="False" Margin="10,0,0,0"/>
                                            <Button x:Name="ReportButton" Content="Abrir localização do relatório" Tag="{StaticResource IconFolder}"
                                                    Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                                    Click="OnOpenReport" IsEnabled="False" AutomationProperties.AutomationId="OpenReportFolder"/>
                                        </StackPanel>
                                        <Rectangle Height="1" Fill="White" Opacity="0.09" Margin="0,20,0,14"/>
                                        <TextBlock x:Name="ExecutionStatus" Text="Nenhuma auditoria anterior. Inicie uma coleta quando desejar."
                                                   Foreground="#C3D6E6" AutomationProperties.LiveSetting="Polite"/>
                                        <ProgressBar x:Name="AuditProgressBar" Margin="0,12,0,0" Minimum="0" Maximum="6" Value="0" Background="#0E2234"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,0">
                                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,8,0">
                                    <StackPanel>
                                        <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource TileGradient}" BorderBrush="#2F6482" BorderThickness="1" HorizontalAlignment="Left">
                                            <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconComputer}" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                                        </Border>
                                        <TextBlock Text="Este computador" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
                                        <TextBlock x:Name="ComputerSummary" Text="Inventário ainda não coletado" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="ComputerDetail" Text="Execute a primeira auditoria básica." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="20" Margin="8,0">
                                    <StackPanel>
                                        <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource TileGradient}" BorderBrush="#2F6482" BorderThickness="1" HorizontalAlignment="Left">
                                            <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconShieldCheck}" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                                        </Border>
                                        <TextBlock Text="Auditoria básica · validade de 7 dias" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
                                        <TextBlock x:Name="BasicState" Text="Nenhuma auditoria" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="BasicDate" Text="Último sucesso: nunca" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="20" Margin="8,0,0,0">
                                    <StackPanel>
                                        <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource SurfaceRaised}" BorderBrush="#34506E" BorderThickness="1" HorizontalAlignment="Left">
                                            <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconResults}" Stroke="{StaticResource Muted}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                                        </Border>
                                        <TextBlock Text="Auditoria completa · validade de 30 dias" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
                                        <TextBlock x:Name="FullState" Text="Nenhuma auditoria" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="FullDate" Text="Coleta completa prevista para fases futuras." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <StackPanel Grid.Row="2" Margin="0,24,0,0">
                                <TextBlock Text="Ir para" Style="{StaticResource PaneTitle}" Margin="0,0,0,12"/>
                                <UniformGrid Columns="4">
                                    <Button Style="{StaticResource TileButton}" Tag="1" Click="OnNavigate" Margin="0,0,8,0" AutomationProperties.Name="Abrir Resultados">
                                        <StackPanel>
                                            <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource TileGradient}" BorderBrush="#2F6482" BorderThickness="1" HorizontalAlignment="Left"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconResults}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                            <TextBlock Text="Resultados" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                            <TextBlock Text="Evidências por categoria da última auditoria." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource TileButton}" Tag="2" Click="OnNavigate" Margin="8,0" AutomationProperties.Name="Abrir Hardware">
                                        <StackPanel>
                                            <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource TileGradient}" BorderBrush="#2F6482" BorderThickness="1" HorizontalAlignment="Left"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconHardware}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                            <TextBlock Text="Hardware" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                            <TextBlock Text="Inventário em 11 categorias de dispositivos." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource TileButton}" Tag="3" Click="OnNavigate" Margin="8,0" AutomationProperties.Name="Abrir Estabilidade e Eventos">
                                        <StackPanel>
                                            <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource TileGradient}" BorderBrush="#2F6482" BorderThickness="1" HorizontalAlignment="Left"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconEvents}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                            <TextBlock Text="Estabilidade e Eventos" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                            <TextBlock Text="Log de Eventos e relatórios de falha do Windows." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource TileButton}" Tag="8" Click="OnNavigate" Margin="8,0,0,0" AutomationProperties.Name="Abrir Histórico">
                                        <StackPanel>
                                            <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource TileGradient}" BorderBrush="#2F6482" BorderThickness="1" HorizontalAlignment="Left"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconHistory}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                            <TextBlock Text="Histórico" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                            <TextBlock Text="Auditorias salvas neste computador." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Style="{StaticResource FootNote}" Margin="0,16,0,0"
                                       Text="Auditoria e inventário somente de leitura. Campos indisponíveis não são estimados; estado reportado pelo Windows não garante integridade física. Renderização por software."/>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ───── Resultados ───── -->
                <TabItem Header="Resultados">
                    <Grid Margin="32,28,32,24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="13" Background="{StaticResource TileGradient}" BorderBrush="#2F6482" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Top"><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconResults}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border><StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ResultHeading" Text="Resultados da última auditoria" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="LastCheck" Text="Última verificação: nunca" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel></Grid>
                        <Grid Grid.Row="1" Margin="0,22,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="4">
                                <ListBox x:Name="CollectorList" SelectionChanged="OnCollectorSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="Categorias da auditoria">
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource Subtle}" Margin="0,2,12,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Concluída"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource Success}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Parcial"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource Warn}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Cancelada"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource Warn}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Falhou"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource Danger}"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <TextBox x:Name="CollectorDetails" Grid.Column="2" Text="Os resultados reais aparecerão aqui após a primeira coleta."
                                     AutomationProperties.Name="Evidências do coletor selecionado"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ───── Hardware ───── -->
                <TabItem Header="Hardware">
                    <Grid Margin="32,28,32,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="13" Background="{StaticResource TileGradient}" BorderBrush="#2F6482" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Top"><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconHardware}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border><StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Inventário de hardware" Style="{StaticResource PageTitle}"/>
                                <TextBlock x:Name="HardwareSnapshotInfo" Text="Nenhum snapshot de hardware coletado." Style="{StaticResource PageSubtitle}"/>
                            </StackPanel></Grid>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                <Button x:Name="HardwareReloadButton" Content="Recarregar" Tag="{StaticResource IconRefresh}" Style="{StaticResource GhostButton}" Click="OnHardwareReload"
                                        ToolTip="Reler os inventários salvos na memória local" AutomationProperties.AutomationId="ReloadHardware"/>
                                <Button x:Name="HardwareCancelButton" Content="Cancelar" Tag="{StaticResource IconStop}" Click="OnHardwareCancel" IsEnabled="False" Margin="8,0,0,0"/>
                                <Button x:Name="HardwareRunButton" Content="Coletar hardware" Tag="{StaticResource IconPlay}" Style="{StaticResource PrimaryButton}"
                                        Click="OnHardwareRun" Margin="8,0,0,0" AutomationProperties.AutomationId="CollectHardware"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="HardwareStatusText" Text="A coleta permanece somente de leitura e não altera o Windows."
                                           Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock x:Name="HardwareSummaryText" Grid.Column="1" Margin="20,0,0,0" Foreground="{StaticResource Subtle}" FontSize="12.5"
                                           VerticalAlignment="Center" TextWrapping="NoWrap"/>
                            </Grid>
                            <ProgressBar x:Name="HardwareProgressBar" Margin="0,10,0,0" Minimum="0" Maximum="11" Value="0"/>
                        </StackPanel>

                        <ListBox x:Name="HardwareCategoryList" Grid.Row="2" Margin="0,16,0,0" Padding="0" SelectionChanged="OnHardwareCategorySelected"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ChipItem}" AutomationProperties.Name="Filtrar por categoria">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" MinWidth="170" MaxWidth="230"/><ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1.6*" MinWidth="270"/><ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="2.2*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Inventários salvos" Style="{StaticResource PaneTitle}"/>
                                <Border Grid.Row="1" Style="{StaticResource Card}">
                                    <ListBox x:Name="HardwareSnapshotList" SelectionChanged="OnHardwareSnapshotSelected"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                             AutomationProperties.Name="Histórico de inventários de hardware">
                                        <ListBox.ItemTemplate><DataTemplate><StackPanel>
                                            <TextBlock Text="{Binding DateText}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock x:Name="HardwareListHeading" Text="Itens" Style="{StaticResource PaneTitle}"/>
                                <Border Grid.Row="1" Style="{StaticResource Card}">
                                  <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid Margin="8,8,8,4">
                                        <TextBox x:Name="HardwareSearch" Style="{StaticResource SearchBox}" TextChanged="OnHardwareSearchChanged"
                                                 Background="#0E1826"
                                                 ToolTip="Buscar por nome, fabricante, modelo, ID de hardware ou propriedade"
                                                 AutomationProperties.Name="Buscar no inventário de hardware"/>
                                        <TextBlock x:Name="HardwareSearchHint" Text="Buscar nome, modelo, ID ou propriedade…" Foreground="{StaticResource Subtle}"
                                                   Margin="39,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <ListBox x:Name="HardwareItemList" Grid.Row="1" SelectionChanged="OnHardwareItemSelected"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                             AutomationProperties.Name="Itens de hardware">
                                        <ListBox.ItemTemplate><DataTemplate><StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Accent}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                  </Grid>
                                </Border>
                            </Grid>
                            <Grid Grid.Column="4">
                                <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HardwareDetailsHeading" Text="Visão geral" Style="{StaticResource PaneTitle}" FontSize="15" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="HardwareCompareButton" Grid.Column="1" Content="Comparar anterior" Tag="{StaticResource IconCompare}" Style="{StaticResource CompactButton}"
                                            Click="OnHardwareCompare" IsEnabled="False" Margin="8,0,0,0" ToolTip="Comparar este snapshot com o inventário salvo imediatamente anterior"/>
                                    <Button x:Name="HardwareReportButton" Grid.Column="2" Content="Abrir pasta" Tag="{StaticResource IconFolder}" Style="{StaticResource CompactButton}"
                                            Click="OnOpenHardwareReport" IsEnabled="False" Margin="8,0,0,0" ToolTip="Abrir a pasta do relatório Markdown deste snapshot"/>
                                </Grid>
                                <TextBox x:Name="HardwareDetails" Grid.Row="1" FontSize="13"
                                         Text="Nenhum inventário disponível. Use 'Coletar hardware' ou abra a auditoria básica."
                                         AutomationProperties.Name="Detalhes e propriedades do hardware"/>
                            </Grid>
                        </Grid>

                        <TextBlock Grid.Row="4" Style="{StaticResource FootNote}" Margin="0,12,0,0"
                                   Text="Leitura somente. Campos indisponíveis não são estimados; estado reportado pelo Windows não garante integridade física. Diferença observada não implica causa."/>
                    </Grid>
                </TabItem>

                <!-- ───── Estabilidade e Eventos ───── -->
                <TabItem Header="Estabilidade e Eventos">
                    <Grid Margin="32,28,32,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="13" Background="{StaticResource TileGradient}" BorderBrush="#2F6482" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Top"><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconEvents}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border><StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Estabilidade e Eventos" Style="{StaticResource PageTitle}"/>
                                <TextBlock x:Name="EventInvestigationInfo" Text="Nenhuma investigação de eventos realizada." Style="{StaticResource PageSubtitle}"/>
                                <TextBlock x:Name="EventQualityText" Text="" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="EventQuality"/>
                                <TextBlock x:Name="EventStorageIdentityText" Foreground="{StaticResource Subtle}" FontSize="12" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel></Grid>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,2,0,0">
                                <Button x:Name="EventReloadButton" Content="Recarregar" Tag="{StaticResource IconRefresh}" Style="{StaticResource GhostButton}" Click="OnEventReload"
                                        ToolTip="Reler as investigações salvas na memória local" AutomationProperties.AutomationId="ReloadEvents"/>
                                <Button x:Name="EventCancelButton" Content="Cancelar" Tag="{StaticResource IconStop}" Click="OnEventCancel" IsEnabled="False" Margin="8,0,0,0"/>
                                <Button x:Name="EventRunButton" Content="Investigar eventos" Tag="{StaticResource IconPlay}" Style="{StaticResource PrimaryButton}"
                                        Click="OnEventRun" Margin="8,0,0,0" AutomationProperties.AutomationId="InvestigateEvents"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Text="Período" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="EventWindowCombo" Width="160" SelectionChanged="OnEventWindowChanged" DisplayMemberPath="Label" AutomationProperties.AutomationId="EventWindow"/>
                            <StackPanel x:Name="EventCustomDates" Orientation="Horizontal" Visibility="Collapsed" Margin="12,0,0,0">
                                <DatePicker x:Name="EventFromPicker" Width="140" SelectedDateChanged="OnEventDatesChanged" AutomationProperties.Name="Início do período personalizado"/>
                                <TextBlock Text="até" Foreground="{StaticResource Muted}" Margin="10,0" VerticalAlignment="Center"/>
                                <DatePicker x:Name="EventToPicker" Width="140" SelectedDateChanged="OnEventDatesChanged" AutomationProperties.Name="Fim do período personalizado"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,16,0,0">
                            <TextBlock x:Name="EventStatusText" Text="Leitura somente dos canais de eventos e metadados WER. Nenhuma configuração do Windows será alterada."
                                       Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
                            <ProgressBar x:Name="EventProgressBar" Margin="0,10,0,0" Minimum="0" Maximum="2" Value="0"/>
                        </StackPanel>

                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="EventGroupCountText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                    <TextBlock Text="Grupos" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="1" Background="{StaticResource Line}" Margin="20,2"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="EventRecordCountText" Text="—" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock Text="Registros" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="3" Width="1" Background="{StaticResource Line}" Margin="20,2"/>
                                <StackPanel Grid.Column="4">
                                    <TextBlock x:Name="EventReportCountText" Text="—" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock Text="Relatórios distintos" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="5" Width="1" Background="{StaticResource Line}" Margin="20,2"/>
                                <StackPanel Grid.Column="6">
                                    <TextBlock x:Name="EventLastSeenText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    <TextBlock Text="Última ocorrência" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" MinWidth="170" MaxWidth="230"/><ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1.5*" MinWidth="260"/><ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="2.2*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Investigações salvas" Style="{StaticResource PaneTitle}"/>
                                <Border Grid.Row="1" Style="{StaticResource Card}">
                                    <ListBox x:Name="EventHistoryList" SelectionChanged="OnEventHistorySelected"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                             AutomationProperties.Name="Histórico de investigações de eventos">
                                        <ListBox.ItemTemplate><DataTemplate><StackPanel>
                                            <TextBlock Text="{Binding DateText}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding QualityText}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding QualityState}" Value="Affected">
                                                                <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding QualityState}" Value="Undetermined">
                                                                <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock x:Name="EventGroupHeading" Text="Grupos" Style="{StaticResource PaneTitle}"/>
                                <Border Grid.Row="1" Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid Margin="8,8,8,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions>
                                            <Grid>
                                                <TextBox x:Name="EventSearch" Style="{StaticResource SearchBox}" Background="#0E1826" TextChanged="OnEventSearchChanged"
                                                         ToolTip="Buscar por título, provedor, código, canal ou fonte" AutomationProperties.Name="Buscar grupos de evidência"/>
                                                <TextBlock x:Name="EventSearchHint" Text="Buscar grupos…" Foreground="{StaticResource Subtle}"
                                                           Margin="39,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" TextWrapping="NoWrap"/>
                                            </Grid>
                                            <ComboBox x:Name="EventCategoryCombo" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="OnEventCategorySelected"
                                                      DisplayMemberPath="Label" AutomationProperties.Name="Filtrar por categoria de evento" AutomationProperties.AutomationId="EventCategory"/>
                                        </Grid>
                                        <ListBox x:Name="EventGroupList" Grid.Row="1" SelectionChanged="OnEventGroupSelected"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                 AutomationProperties.Name="Grupos de evidência do período">
                                            <ListBox.ItemTemplate><DataTemplate><StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="12" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Accent}" FontSize="11.5" Margin="0,4,0,0"/>
                                            </StackPanel></DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Grid Grid.Column="4">
                                <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="EventDetailsHeading" Text="Detalhes" Style="{StaticResource PaneTitle}" FontSize="15" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="EventReportButton" Grid.Column="1" Content="Abrir pasta" Tag="{StaticResource IconFolder}" Style="{StaticResource CompactButton}" VerticalAlignment="Center"
                                            Click="OnOpenEventReport" IsEnabled="False" ToolTip="Abrir a pasta do relatório Markdown desta investigação"
                                            AutomationProperties.AutomationId="OpenEventReportFolder"/>
                                </Grid>
                                <TextBox x:Name="EventDetails" Grid.Row="1" FontSize="13"
                                         Text="Nenhuma investigação disponível. Use 'Investigar eventos' ou abra uma investigação salva."
                                         AutomationProperties.Name="Detalhes técnicos e evidências do grupo selecionado"/>
                            </Grid>
                        </Grid>

                        <TextBlock Grid.Row="5" Style="{StaticResource FootNote}" Margin="0,12,0,0"
                                   Text="Leitura somente. Evento observado não confirma causa nem defeito de hardware. Contagens parciais ou limitadas não representam o total do sistema."/>
                    </Grid>
                </TabItem>

                <!-- ───── Desempenho ───── -->
                <TabItem Header="Desempenho">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <Grid Margin="32,28,32,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Duração:" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                <ComboBox x:Name="PerformanceDurationCombo" Width="160" Margin="8,0,12,0"
                                          SelectionChanged="OnPerformanceDurationChanged"
                                          AutomationProperties.AutomationId="PerformanceDuration" DisplayMemberPath="Label"/>
                                <Button x:Name="PerformanceRunButton" Content="Iniciar sessão" Background="#19506A" BorderBrush="#63D8EE"
                                        Click="OnPerformanceRun" AutomationProperties.AutomationId="StartPerformanceSession"
                                        MinWidth="120" Margin="12,0,0,0"/>
                                <Button x:Name="PerformanceCancelButton" Content="Cancelar" Margin="10,0,0,0"
                                        Click="OnPerformanceCancel" IsEnabled="False"
                                        AutomationProperties.AutomationId="CancelPerformanceSession"/>
                                <Button x:Name="PerformanceReportButton" Content="Abrir relatório" Margin="10,0,0,0"
                                        Click="OnPerformanceReport" IsEnabled="False"
                                        AutomationProperties.AutomationId="OpenPerformanceReport"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <ProgressBar x:Name="PerformanceProgress" Height="8" Minimum="0" Maximum="1"
                                             AutomationProperties.AutomationId="PerformanceProgress" Background="#1B2B40"/>
                                <TextBlock x:Name="PerformanceStatusText" Margin="0,6,0,0" Foreground="{StaticResource Muted}"
                                           TextWrapping="Wrap" FontSize="13.5"/>
                            </StackPanel>

                            <Border x:Name="PerformanceQualityBanner" Grid.Row="2" Margin="0,10,0,0"
                                    Padding="12,8" CornerRadius="8" Background="{StaticResource WarnSoft}"
                                    BorderBrush="{StaticResource WarnLine}" BorderThickness="1"
                                    Visibility="Collapsed"
                                    AutomationProperties.AutomationId="PerformanceQualityBanner">
                                <TextBlock x:Name="PerformanceQualityText" Foreground="{StaticResource Warn}"
                                           FontSize="12.5" TextWrapping="Wrap"/>
                            </Border>

                            <UniformGrid Grid.Row="3" Columns="4" Margin="0,12,0,0">
                                <Border Style="{StaticResource Card}" Padding="16" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="CPU" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="PerformanceCpuValue" FontSize="22" Foreground="#63D8EE"
                                                   FontWeight="SemiBold" Text="—" AutomationProperties.AutomationId="PerformanceCpuValue"/>
                                        <TextBlock x:Name="PerformanceCpuDetail" Foreground="{StaticResource Muted}" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="16" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="Memória" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="PerformanceMemoryValue" FontSize="22" Foreground="#63D8EE"
                                                   FontWeight="SemiBold" Text="—" AutomationProperties.AutomationId="PerformanceMemoryValue"/>
                                        <TextBlock x:Name="PerformanceMemoryDetail" Foreground="{StaticResource Muted}" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="16" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="Processos" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="PerformanceProcessValue" FontSize="22" Foreground="#63D8EE"
                                                   FontWeight="SemiBold" Text="—" AutomationProperties.AutomationId="PerformanceProcessValue"/>
                                        <TextBlock x:Name="PerformanceProcessDetail" Foreground="{StaticResource Muted}" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="16" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="Armazenamento" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="PerformanceStorageValue" FontSize="22" Foreground="#63D8EE"
                                                   FontWeight="SemiBold" Text="—" AutomationProperties.AutomationId="PerformanceStorageValue"/>
                                        <TextBlock x:Name="PerformanceStorageDetail" Foreground="{StaticResource Muted}" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Grid.Row="4" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <TabControl x:Name="PerformanceTabs" Grid.Column="0">
                                    <TabItem Header="Indicadores">
                                        <Border Style="{StaticResource Card}">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Indicador" Foreground="{StaticResource Muted}" FontSize="12.5" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="Média" Foreground="{StaticResource Muted}" FontSize="12.5" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="2" Text="Detalhe" Foreground="{StaticResource Muted}" FontSize="12.5" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </Border>
                                                <ListView x:Name="PerformanceMetricList" Grid.Row="1"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          AutomationProperties.AutomationId="PerformanceMetrics"
                                                          VirtualizingPanel.IsVirtualizing="True"
                                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                                    <ListView.ItemTemplate><DataTemplate>
                                                        <DataTemplate.Resources>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataTemplate.Resources>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                                        </Grid>
                                                    </DataTemplate></ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="Processos">
                                        <Border Style="{StaticResource Card}">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Processo" Foreground="{StaticResource Muted}" FontSize="12.5" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="CPU média" Foreground="{StaticResource Muted}" FontSize="12.5" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="2" Text="Memória privada" Foreground="{StaticResource Muted}" FontSize="12.5" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="3" Text="Detalhe" Foreground="{StaticResource Muted}" FontSize="12.5" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </Border>
                                                <ListView x:Name="PerformanceProcessList" Grid.Row="1"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          VirtualizingPanel.IsVirtualizing="True"
                                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                                          AutomationProperties.AutomationId="PerformanceProcesses">
                                                    <ListView.ItemTemplate><DataTemplate>
                                                        <DataTemplate.Resources>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataTemplate.Resources>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Cpu}" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Memory}" VerticalAlignment="Center" Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Detail}" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                                        </Grid>
                                                    </DataTemplate></ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="Armazenamento">
                                        <Border Style="{StaticResource Card}">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Dispositivo" Foreground="{StaticResource Muted}" FontSize="12.5" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="Vazão" Foreground="{StaticResource Muted}" FontSize="12.5" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="2" Text="Detalhe" Foreground="{StaticResource Muted}" FontSize="12.5" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </Border>
                                                <ListView x:Name="PerformanceStorageList" Grid.Row="1"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          AutomationProperties.AutomationId="PerformanceStorage">
                                                    <ListView.ItemTemplate><DataTemplate>
                                                        <DataTemplate.Resources>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataTemplate.Resources>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Throughput}" VerticalAlignment="Center" Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                                        </Grid>
                                                    </DataTemplate></ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="Evidências">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Style="{StaticResource Card}" Grid.Row="0">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="Título" Foreground="{StaticResource Muted}" FontSize="12.5" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="1" Text="Classificação" Foreground="{StaticResource Muted}" FontSize="12.5" FontWeight="SemiBold"/>
                                                        </Grid>
                                                    </Border>
                                                    <ListView x:Name="PerformanceObservationList" Grid.Row="1"
                                                              SelectionChanged="OnPerformanceObservationSelected"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                              AutomationProperties.AutomationId="PerformanceObservations">
                                                        <ListView.ItemTemplate><DataTemplate>
                                                            <DataTemplate.Resources>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                </Style>
                                                            </DataTemplate.Resources>
                                                            <Grid>
