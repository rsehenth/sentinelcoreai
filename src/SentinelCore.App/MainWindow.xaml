                                            </Grid>
                                            <ComboBox x:Name="EventCategoryCombo" Margin="0,6,0,0" SelectionChanged="OnEventCategorySelected"
                                                      DisplayMemberPath="Label" AutomationProperties.Name="{DynamicResource T211}" AutomationProperties.AutomationId="EventCategory"/>
                                        </StackPanel>
                                        <ListBox x:Name="EventGroupList" Tag="Nenhum grupo carregado." Grid.Row="1" SelectionChanged="OnEventGroupSelected"
