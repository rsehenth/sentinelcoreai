                                <TextBlock x:Name="EventQualityText" Text="" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="EventQuality"/>
                                <TextBlock x:Name="EventStorageIdentityText" Foreground="{StaticResource Subtle}" FontSize="12" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel></Grid>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,2,0,0">
                                <Button x:Name="EventReloadButton" Content="{DynamicResource T379}" Tag="{StaticResource IconRefresh}" Style="{StaticResource GhostButton}" Click="OnEventReload"
                                        ToolTip="{DynamicResource T401}" AutomationProperties.AutomationId="ReloadEvents"/>
                                <Button x:Name="EventCancelButton" Content="{DynamicResource T79}" Tag="{StaticResource IconStop}" Click="OnEventCancel" IsEnabled="False" Margin="8,0,0,0"/>
                                <Button x:Name="EventRunButton" Content="{DynamicResource T278}" Tag="{StaticResource IconPlay}" Style="{StaticResource PrimaryButton}"
