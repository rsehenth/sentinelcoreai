<Window x:Class="SentinelCore.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SentinelCore.App"
        Title="{DynamicResource T435}" Width="1320" Height="860" MinWidth="960" MinHeight="520"
        Icon="Assets/app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnWindowKeyDown">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- ═══════════ Menu lateral ═══════════ -->
        <Border Background="{StaticResource SidebarGradient}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="10,14,10,10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <Grid Margin="2,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="BrandMark" Style="{StaticResource TileIcon}" Margin="0,0,10,0" ToolTip="{DynamicResource T435}">
                        <Viewbox Width="20" Height="22">
                            <Canvas Width="44" Height="48">
                                <Path Data="M 22,6 L 36,12 L 34,29 L 22,40 L 10,29 L 8,12 Z M 15,23 L 20,28 L 29,17" Stroke="{StaticResource Accent}"
                                      StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel x:Name="BrandText" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource T435}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                        <TextBlock Text="{DynamicResource T156}" Style="{StaticResource Caption}" FontSize="12" Margin="0,1,0,0" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <Button x:Name="SidebarToggle" Grid.Column="2" Style="{StaticResource GhostButton}" Tag="{StaticResource IconSidebar}" Click="OnToggleSidebar"
                            MinHeight="32" MinWidth="32" Padding="0" ToolTip="{DynamicResource T380}"
                            AutomationProperties.Name="{DynamicResource T381}" AutomationProperties.AutomationId="SidebarToggle" AutomationProperties.AcceleratorKey="Ctrl+B"/>
                </Grid>

                <ListBox x:Name="NavList" Grid.Row="1" SelectedIndex="0" SelectionChanged="OnNavChanged" Padding="0" AutomationProperties.Name="{DynamicResource T306}"
                         ItemContainerStyle="{StaticResource NavItem}" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Content="{DynamicResource T472}" local:Nav.Group="{DynamicResource T1067}" Tag="{StaticResource IconOverview}" ToolTip="{DynamicResource T473}"/>
                    <ListBoxItem Content="{DynamicResource T412}" Tag="{StaticResource IconResults}" ToolTip="{DynamicResource T413}"/>
                    <ListBoxItem Content="{DynamicResource T224}" Tag="{StaticResource IconHardware}" ToolTip="{DynamicResource T225}"/>
                    <ListBoxItem Content="{DynamicResource T179}" Tag="{StaticResource IconEvents}" ToolTip="{DynamicResource T180}"/>
                    <ListBoxItem Content="{DynamicResource T140}" Tag="{StaticResource IconPerformance}" ToolTip="{DynamicResource T141}"/>
                    <ListBoxItem Content="{DynamicResource T386}" Tag="{StaticResource IconNetwork}" ToolTip="{DynamicResource T387}"/>
                    <ListBoxItem Content="{DynamicResource T220}" Tag="{StaticResource IconGraphics}" ToolTip="{DynamicResource T221}"/>
                    <ListBoxItem Content="{DynamicResource T119}" Tag="{StaticResource IconCompare}" ToolTip="{DynamicResource T120}"/>
                    <ListBoxItem Content="{DynamicResource T226}" local:Nav.Group="{DynamicResource T393}" Tag="{StaticResource IconHistory}" ToolTip="{DynamicResource T227}"/>
                    <ListBoxItem Content="{DynamicResource T311}" Tag="{StaticResource IconPerformance}" ToolTip="{DynamicResource T312}"/>
                    <ListBoxItem x:Name="TweaksNav" Content="{DynamicResource T355}" local:Nav.Group="{DynamicResource T1068}" Tag="{StaticResource IconShieldCheck}" ToolTip="{DynamicResource T356}"/>
                    <ListBoxItem x:Name="RepairsNav" Content="{DynamicResource T404}" Tag="{StaticResource IconShieldCheck}" ToolTip="{DynamicResource T405}"/>
                    <ListBoxItem x:Name="RecoveryNav" Content="{DynamicResource T93}" Tag="{StaticResource IconHistory}" ToolTip="{DynamicResource T94}"/>
                </ListBox>

                <ComboBox x:Name="LanguageRow" Grid.Row="2" Margin="4,8,4,0" MinHeight="30" Padding="10,0" FontSize="12.5"
                          SelectionChanged="OnLanguageChanged" AutomationProperties.Name="Language" ToolTip="English / Português">
                    <ComboBoxItem Content="English"/>
                    <ComboBoxItem Content="Português"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- ═══════════ Conteúdo ═══════════ -->
        <Grid Grid.Column="1" Background="{StaticResource WindowGlow}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- Avisos globais: integridade (persistem) + falhas da execução atual. Limite de altura com rolagem para não ocupar a página. -->
            <Border x:Name="WarningBanner" Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnLine}" BorderThickness="1"
                    CornerRadius="10" Padding="14,10,6,10" Margin="32,16,32,0" Visibility="Collapsed" AutomationProperties.Name="{DynamicResource T66}" AutomationProperties.LiveSetting="Polite">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Viewbox Width="18" Height="18" Margin="0,1,12,0" VerticalAlignment="Top">
                        <Canvas Width="24" Height="24"><Path Data="{StaticResource IconWarning}" Stroke="{StaticResource Warn}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
                    </Viewbox>
                    <ScrollViewer Grid.Column="1" MaxHeight="96" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <TextBlock x:Name="StorageWarnings" Foreground="{StaticResource Warn}" Margin="0,0,8,0"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <TabControl x:Name="Pages" Grid.Row="1" Style="{StaticResource PageHost}"
                        SelectedIndex="{Binding SelectedIndex, ElementName=NavList, Mode=TwoWay}">

                <!-- ───── Visão geral ───── -->
                <TabItem Header="{DynamicResource T472}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="32,24,32,20">

                            <!-- Cabeçalho: estado da auditoria à esquerda, ações empilhadas à direita (sem linha horizontal longa). -->
                            <Border CornerRadius="18" Background="{StaticResource HeroGradient}" BorderBrush="#2F5B7E" BorderThickness="1" Padding="28,22" ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="180" Height="198" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,250,0" Opacity="0.14" IsHitTestVisible="False">
                                        <Canvas Width="44" Height="48">
                                            <Path Data="M 22,6 L 36,12 L 34,29 L 22,40 L 10,29 L 8,12 Z M 15,23 L 20,28 L 29,17" Stroke="{StaticResource Accent}"
                                                  StrokeThickness="0.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel>
                                        <Border HorizontalAlignment="Left" CornerRadius="13" Background="#0F2B3C" BorderBrush="#2B6078" BorderThickness="1" Padding="11,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="13" Height="13" Margin="0,0,7,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconLock}" Stroke="{StaticResource Success}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                                                <TextBlock Text="{DynamicResource T450}" FontSize="12" Foreground="#BFE9F3" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{DynamicResource T472}" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <TextBlock Text="{DynamicResource T54}" Style="{StaticResource PageSubtitle}" Foreground="#A9C4D8" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="ExecutionStatus" Text="{DynamicResource T321}" Margin="0,18,0,0"
                                                   Foreground="#C3D6E6" AutomationProperties.LiveSetting="Polite"/>
                                        <ProgressBar x:Name="AuditProgressBar" Margin="0,10,0,0" Minimum="0" Maximum="1" Value="0" Background="#0E2234"
                                                     AutomationProperties.Name="{DynamicResource T189}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Width="236" Margin="24,0,0,0" VerticalAlignment="Center">
                                        <ComboBox x:Name="AuditKindCombo" SelectedIndex="0" Margin="0,0,0,8"
                                                  AutomationProperties.Name="{DynamicResource T457}">
                                            <ComboBoxItem Content="{DynamicResource T48}"/>
                                            <ComboBoxItem x:Name="FullAuditOption" Content="{DynamicResource T50}"/>
                                        </ComboBox>
                                        <Button x:Name="RunButton" Content="{DynamicResource T263}" Tag="{StaticResource IconPlay}" Style="{StaticResource PrimaryButton}"
                                                Click="OnRun" AutomationProperties.AutomationId="RunBasicAudit"/>
                                        <Button x:Name="CancelButton" Content="{DynamicResource T81}" Tag="{StaticResource IconStop}" Click="OnCancel" IsEnabled="False" Margin="0,8,0,0"/>
                                        <Button x:Name="ReportButton" Content="{DynamicResource T298}" Tag="{StaticResource IconFolder}"
                                                Style="{StaticResource GhostButton}" Margin="0,4,0,0" ToolTip="{DynamicResource T7}"
                                                Click="OnOpenReport" IsEnabled="False" AutomationProperties.AutomationId="OpenReportFolder"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="3" Margin="0,16,0,0">
                                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,8,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource TileIcon}" Width="34" Height="34" CornerRadius="9" Background="{StaticResource TileGradient}" Margin="0,0,12,0" VerticalAlignment="Center"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconComputer}" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource T187}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="ComputerSummary" Text="{DynamicResource T271}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="ComputerDetail" Text="{DynamicResource T203}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="18,16" Margin="8,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource TileIcon}" Width="34" Height="34" CornerRadius="9" Background="{StaticResource TileGradient}" Margin="0,0,12,0" VerticalAlignment="Center"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconShieldCheck}" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource T49}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="BasicState" Text="{DynamicResource T319}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="BasicDate" Text="{DynamicResource T464}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="18,16" Margin="8,0,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource TileIcon}" Width="34" Height="34" CornerRadius="9" Background="{StaticResource SurfaceRaised}" Margin="0,0,12,0" VerticalAlignment="Center"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconResults}" Stroke="{StaticResource Muted}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource T51}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="FullState" Text="{DynamicResource T319}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="FullDate" Text="{DynamicResource T464}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Text="{DynamicResource T157}" Style="{StaticResource PaneTitle}" Margin="0,22,0,10"/>
                            <UniformGrid Columns="4">
                                <Button Style="{StaticResource TileButton}" Tag="1" Click="OnNavigate" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource T25}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource TileIcon}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconResults}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource T412}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{DynamicResource T199}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource TileButton}" Tag="2" Click="OnNavigate" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource T15}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource TileIcon}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconHardware}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource T224}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{DynamicResource T274}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource TileButton}" Tag="3" Click="OnNavigate" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource T13}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource TileIcon}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconEvents}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource T179}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{DynamicResource T299}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource TileButton}" Tag="4" Click="OnNavigate" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource T12}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource TileIcon}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconPerformance}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource T140}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{DynamicResource T440}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource TileButton}" Tag="5" Click="OnNavigate" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource T21}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource TileIcon}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconNetwork}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource T386}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{DynamicResource T159}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource TileButton}" Tag="6" Click="OnNavigate" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource T14}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource TileIcon}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconGraphics}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource T220}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{DynamicResource T30}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource TileButton}" Tag="7" Click="OnNavigate" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource T11}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource TileIcon}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconCompare}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource T119}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{DynamicResource T398}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource TileButton}" Tag="9" Click="OnNavigate" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource T17}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource TileIcon}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconPerformance}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource T311}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{DynamicResource T437}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </UniformGrid>

                            <TextBlock Text="{DynamicResource T244}" Style="{StaticResource PaneTitle}" Margin="0,10,0,10"/>
                            <UniformGrid Columns="4">
                                <Button Style="{StaticResource TileButton}" Tag="8" Click="OnNavigate" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource T16}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource TileIcon}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconHistory}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource T226}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{DynamicResource T57}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource TileButton}" Tag="10" Click="OnNavigate" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource T20}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource TileIcon}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconShieldCheck}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource T355}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{DynamicResource T443}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource TileButton}" Tag="11" Click="OnNavigate" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource T24}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource TileIcon}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconShieldCheck}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource T404}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{DynamicResource T444}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource TileButton}" Tag="12" Click="OnNavigate" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource T10}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource TileIcon}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconHistory}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource T93}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{DynamicResource T249}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </UniformGrid>

                            <TextBlock Style="{StaticResource FootNote}" Margin="0,10,0,0"
                                       Text="{DynamicResource T52}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ───── Resultados ───── -->
                <TabItem x:Name="AuditResultsTab" Header="{DynamicResource T412}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <Border Padding="32,28,32,24" MinHeight="520" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"><Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource PageIcon}"><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconResults}" Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border><StackPanel Grid.Column="1" VerticalAlignment="Center">
