                                                    <TextBlock Grid.Column="3" Text="{DynamicResource T333}" Foreground="{StaticResource Muted}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                            <ListView x:Name="MonitoringTimelineList" Grid.Row="1"
