<Application x:Class="SentinelCore.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- ══ Tokens de cor: azul-grafite com ciano como único acento ══ -->
        <SolidColorBrush x:Key="Bg" Color="#0A111C" />
        <SolidColorBrush x:Key="Sidebar" Color="#0D1623" />
        <SolidColorBrush x:Key="Surface" Color="#121D2D" />
        <SolidColorBrush x:Key="SurfaceRaised" Color="#1A2A3F" />
        <SolidColorBrush x:Key="SurfaceHover" Color="#15243A" />
        <SolidColorBrush x:Key="Line" Color="#223349" />
        <SolidColorBrush x:Key="LineStrong" Color="#34506E" />
        <SolidColorBrush x:Key="Text" Color="#E8EEF6" />
        <SolidColorBrush x:Key="Muted" Color="#9FB2C7" />
        <SolidColorBrush x:Key="Subtle" Color="#7A90A8" />
        <SolidColorBrush x:Key="Accent" Color="#4FD1E8" />
        <SolidColorBrush x:Key="AccentSoft" Color="#12384A" />
        <SolidColorBrush x:Key="OnAccent" Color="#04202A" />
        <SolidColorBrush x:Key="Warn" Color="#F5C27A" />
        <SolidColorBrush x:Key="WarnSoft" Color="#2A2112" />
        <SolidColorBrush x:Key="WarnLine" Color="#5C4520" />
        <SolidColorBrush x:Key="Danger" Color="#F2778A" />
        <SolidColorBrush x:Key="Success" Color="#5FD3A0" />

        <!-- Gradientes sutis: só pincéis (sem efeitos de pixel), compatíveis com a renderização por software. -->
        <LinearGradientBrush x:Key="SurfaceGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#17273E" Offset="0" /><GradientStop Color="#111C2D" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="EdgeGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#36547A" Offset="0" /><GradientStop Color="#1D2E45" Offset="0.55" /><GradientStop Color="#18273B" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#62E3F4" Offset="0" /><GradientStop Color="#3FA9E8" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4FD1E8" Offset="0" /><GradientStop Color="#5B8DEF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TileGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1F5373" Offset="0" /><GradientStop Color="#123043" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#112036" Offset="0" /><GradientStop Color="#0B1424" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SelectedGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D4261" Offset="0" /><GradientStop Color="#14293F" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B4A68" Offset="0" /><GradientStop Color="#132B45" Offset="0.5" /><GradientStop Color="#0E1B2F" Offset="1" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="WindowGlow" Center="0.85,0" GradientOrigin="0.85,0" RadiusX="0.7" RadiusY="0.6">
            <GradientStop Color="#16405C" Offset="0" /><GradientStop Color="#0F2437" Offset="0.45" /><GradientStop Color="#0A111C" Offset="1" />
        </RadialGradientBrush>

        <CornerRadius x:Key="RadiusM">12</CornerRadius>

        <!-- ══ Ícones (grade 24×24, traço) ══ -->
        <Geometry x:Key="IconOverview">M4,4 H10 V11 H4 Z M14,4 H20 V8 H14 Z M14,12 H20 V20 H14 Z M4,15 H10 V20 H4 Z</Geometry>
        <Geometry x:Key="IconResults">M9,6 H20 M9,12 H20 M9,18 H20 M3.5,6 L5,7.5 L7.5,4.5 M3.5,12 L5,13.5 L7.5,10.5 M3.5,18 L5,19.5 L7.5,16.5</Geometry>
        <Geometry x:Key="IconHardware">M7,7 H17 V17 H7 Z M10,10 H14 V14 H10 Z M9,3 V7 M15,3 V7 M9,17 V21 M15,17 V21 M3,9 H7 M3,15 H7 M17,9 H21 M17,15 H21</Geometry>
        <Geometry x:Key="IconEvents">M3,12 H7 L9.5,5.5 L14,18.5 L16.5,12 H21</Geometry>
        <Geometry x:Key="IconPerformance">M5,5 H19 V19 H5 Z M9,9 H11 V11 H9 Z M13,13 H11 V11 H13 Z M9,17 H11 V19 H9 Z M13,9 H15 V11 H13 Z</Geometry>
        <Geometry x:Key="IconNetwork">M12,4 A2.5,2.5 0 1 0 12,9 A2.5,2.5 0 1 0 12,4 M5,14.5 A2.5,2.5 0 1 0 5,19.5 A2.5,2.5 0 1 0 5,14.5 M19,14.5 A2.5,2.5 0 1 0 19,19.5 A2.5,2.5 0 1 0 19,14.5 M12,9 V12 M11.2,11.5 L6.2,14.6 M12.8,11.5 L17.8,14.6</Geometry>
        <Geometry x:Key="IconGraphics">M3,4 H21 V16 H3 Z M10,16 V20 M14,16 V20 M8,20 H16 M8,8 H11 V11 H8 Z M13,8 H16 V11 H13 Z M8,13 H16</Geometry>
        <Geometry x:Key="IconHistory">M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 M12,7 V12 L15,14</Geometry>
        <Geometry x:Key="IconSearch">M4,10.5 A6.5,6.5 0 1 0 17,10.5 A6.5,6.5 0 1 0 4,10.5 M15.5,15.5 L20,20</Geometry>
        <Geometry x:Key="IconLock">M6,11 H18 V20 H6 Z M8.5,11 V8 A3.5,3.5 0 0 1 15.5,8 V11</Geometry>
        <Geometry x:Key="IconChevron">M9,6 L15,12 L9,18</Geometry>
        <Geometry x:Key="IconWarning">M12,4 L21,19 H3 Z M12,10 V14 M12,16.5 V17</Geometry>
        <Geometry x:Key="IconPlay">M7,5 L19,12 L7,19 Z</Geometry>
        <Geometry x:Key="IconStop">M7,7 H17 V17 H7 Z</Geometry>
        <Geometry x:Key="IconFolder">M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z</Geometry>
        <Geometry x:Key="IconRefresh">M20,12 A8,8 0 1 1 17.7,6.3 M20,4 V9 H15</Geometry>
        <Geometry x:Key="IconComputer">M3,5 H21 V16 H3 Z M8,20 H16 M12,16 V20</Geometry>
        <Geometry x:Key="IconShieldCheck">M12,3 L19,6 V12 C19,16.5 16,19.5 12,21 C8,19.5 5,16.5 5,12 V6 Z M9,12 L11,14 L15,10</Geometry>
        <Geometry x:Key="IconCompare">M8,4 L4,8 L8,12 M4,8 H20 M16,12 L20,16 L16,20 M20,16 H4</Geometry>

        <!-- ══ Texto ══ -->
        <!-- A cor padrão vem da herança (Window.Foreground), para que botões e itens possam recolorir o texto. -->
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="PaneTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="FootNote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" /><Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>

        <!-- ══ Superfícies ══ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceGradient}" />
            <Setter Property="BorderBrush" Value="{StaticResource EdgeGradient}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
        </Style>

        <!-- ══ Botões: secundário (padrão), primário, discreto, compacto ══ -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
            <Setter Property="Padding" Value="16,0" /><Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="13.5" /><Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid x:Name="Root">
                    <Border x:Name="FocusRing" Margin="-2" CornerRadius="10" BorderThickness="2" BorderBrush="{StaticResource Accent}" Visibility="Collapsed" />
                    <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox x:Name="IconBox" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="Overlay" Background="White" Opacity="0" CornerRadius="8" IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="IconBox" Property="Visibility" Value="Collapsed" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Overlay" Property="Opacity" Value="0.07" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Overlay" Property="Opacity" Value="0.14" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.38" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentGradient}" />
            <Setter Property="BorderBrush" Value="#7FE9F7" />
            <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="12,0" /><Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid>
                    <Border x:Name="Face" Style="{StaticResource Card}" Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ContentPresenter />
                            <Viewbox x:Name="Chevron" Grid.Column="1" Width="16" Height="16" VerticalAlignment="Top" Opacity="0.55">
                                <Canvas Width="24" Height="24"><Path Data="{StaticResource IconChevron}" Stroke="{StaticResource Muted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceHover}" />
                        <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                        <Setter TargetName="Chevron" Property="Opacity" Value="1" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- ══ Barras de rolagem finas ══ -->
        <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                <Border x:Name="T" Background="{StaticResource LineStrong}" CornerRadius="3" />
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="{StaticResource Subtle}" /></Trigger>
                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="{StaticResource Muted}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <ControlTemplate x:Key="VScrollTemplate" TargetType="ScrollBar">
            <Border Background="Transparent" Width="12">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" Margin="3,0" MinHeight="28" /></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>
        <ControlTemplate x:Key="HScrollTemplate" TargetType="ScrollBar">
            <Border Background="Transparent" Height="12">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageLeftCommand" /></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" Margin="0,3" MinWidth="28" /></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageRightCommand" /></Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
            <Setter Property="Template" Value="{StaticResource VScrollTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Template" Value="{StaticResource HScrollTemplate}" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══ Campos de texto ══ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceGradient}" /><Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" /><Setter Property="BorderBrush" Value="{StaticResource EdgeGradient}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" /><Setter Property="SelectionOpacity" Value="0.35" />
            <Setter Property="Padding" Value="18" /><Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" /><Setter Property="FontSize" Value="13.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="TextBlock.LineHeight" Value="21" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusM}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="False" /><Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="38,0,12,0" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="TextBlock.LineHeight" Value="NaN" />
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" /><Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                            <Canvas Width="24" Height="24"><Path Data="{StaticResource IconSearch}" Stroke="{StaticResource Subtle}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas>
                        </Viewbox>
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- ══ Listas com GridView para colunas alinhadas ══ -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListView">
                <ScrollViewer x:Name="Scroll" Focusable="False" Padding="{TemplateBinding Padding}">
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </ScrollViewer>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Scroll" Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="16,10,12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
                <Grid Margin="0,0,0,2">
                    <Border x:Name="Row" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <Border x:Name="Bar" Visibility="Collapsed" Width="3" Margin="5,11" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource Accent}"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceHover}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedGradient}"/>
                        <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- ══ Listas ══ -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="Padding" Value="4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
                <ScrollViewer x:Name="Scroll" Focusable="False" Padding="{TemplateBinding Padding}">
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </ScrollViewer>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Scroll" Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="Padding" Value="16,10,12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Grid Margin="0,0,0,2">
                    <Border x:Name="Row" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <Border x:Name="Bar" Visibility="Collapsed" Width="3" Margin="5,11" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource Accent}" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceHover}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedGradient}" />
                        <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ChipItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" /><Setter Property="Padding" Value="12,6" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Chip" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="15" Padding="{TemplateBinding Padding}">
                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="{StaticResource SurfaceHover}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Accent}" />
                        <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentSoft}" />
                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="14" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Grid Margin="0,0,0,3">
                    <Border x:Name="Bg" CornerRadius="9" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Height="42" Padding="14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,12,0">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="Icon" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.9"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="Bar" Visibility="Collapsed" Width="3" Height="20" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource Accent}" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bg" Property="Background" Value="#111E30" />
                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource SelectedGradient}" />
                        <Setter TargetName="Bg" Property="BorderBrush" Value="#2A5876" />
                        <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                        <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource Accent}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- ══ Navegação por páginas (sem faixa de abas; o menu lateral comanda) ══ -->
        <Style x:Key="PageHost" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TabPanel IsItemsHost="True" Margin="0,0,0,8"/>
                    <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="Face" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                        CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Face" Property="Background" Value="{StaticResource AccentSoft}"/>
                        <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- ══ Barra de progresso ══ -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6" /><Setter Property="Background" Value="#1B2B40" /><Setter Property="Foreground" Value="{StaticResource ProgressGradient}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Grid>
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                    <Border x:Name="PART_Track" />
                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" />
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- ══ Dica de ferramenta ══ -->
        <Style TargetType="ToolTip">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
                <Border Background="#1A2A3F" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                    <ContentPresenter TextElement.Foreground="{StaticResource Text}" TextElement.FontSize="12.5" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- ══ Lista suspensa ══ -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="FontSize" Value="13.5" />
            <Setter Property="Height" Value="38" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Face" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" />
                        <ContentPresenter Margin="14,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Path Data="M 0,0 L 4.5,4.5 L 9,0" Stroke="{StaticResource Muted}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False" />
                        <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="#16263A" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="8" Padding="4"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,0,8">
                                <ScrollViewer><ItemsPresenter /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource LineStrong}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value><Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="Padding" Value="12,9" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceRaised}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style></Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Seletor de data ══ -->
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource Surface}" /><Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="FontSize" Value="13.5" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="DatePicker">
                    <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Background="Transparent" BorderThickness="0"
                                               Foreground="{TemplateBinding Foreground}" Padding="12,0" VerticalContentAlignment="Center" />
                            <Button x:Name="PART_Button" Grid.Column="1" Width="34" Focusable="False" Style="{x:Null}" Cursor="Hand">
                                <Button.Template><ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <Path Data="M 2,3 L 16,3 L 16,15 L 2,15 Z M 2,7 L 16,7 M 6,1 L 6,4 M 12,1 L 12,4"
                                              Stroke="{StaticResource Muted}" StrokeThickness="1.3" Width="16" Height="15" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate></Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PART_Root" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePickerTextBox">
                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Calendar">
            <Setter Property="Background" Value="{StaticResource Surface}" /><Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        </Style>
    </Application.Resources>
</Application>
