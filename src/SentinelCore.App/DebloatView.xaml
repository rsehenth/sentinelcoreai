<UserControl x:Class="SentinelCore.App.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SentinelCore.App"
             FontFamily="Segoe UI" Foreground="{DynamicResource Text}"
             Loaded="OnLoaded" Unloaded="OnUnloaded"
             AutomationProperties.AutomationId="DebloatView" AutomationProperties.Name="{DynamicResource T218}">
    <UserControl.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource Surface}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Sidebar}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DebloatReadout" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Height" Value="220"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{DynamicResource T131}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="{DynamicResource T118}" Style="{DynamicResource PageSubtitle}"/>
        <TextBlock Text="{DynamicResource T275}" Style="{DynamicResource PaneTitle}" Margin="0,18,0,4" AutomationProperties.AutomationId="DebloatNativeInventoryTitle"/>
        <TextBlock x:Name="NativeInventoryStatus" Text="{DynamicResource T113}"
                   Style="{DynamicResource Caption}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="DebloatNativeInventoryStatus"/>
        <TextBlock Text="{DynamicResource T345}"
                   Style="{DynamicResource FootNote}" Margin="0,4,0,0" AutomationProperties.AutomationId="DebloatNativeInventoryStates"/>
        <TextBlock x:Name="NativeWarnings" Style="{DynamicResource Caption}" Foreground="{DynamicResource Warn}" Margin="0,8,0,0"
                   Visibility="Collapsed" AutomationProperties.Name="{DynamicResource T65}"/>
        <WrapPanel Margin="0,10,0,0">
            <Button x:Name="NativeRefreshButton" Content="{DynamicResource T116}" Style="{DynamicResource PrimaryButton}" IsEnabled="False"
                    Margin="0,0,8,8" Click="OnNativeRefresh"/>
            <Button x:Name="NativeCancelButton" Content="{DynamicResource T82}" Style="{DynamicResource GhostButton}" IsEnabled="False"
                    Margin="0,0,8,8" Click="OnNativeCancel"/>
        </WrapPanel>
        <WrapPanel Margin="0,6,0,6">
            <StackPanel Margin="0,0,12,8">
                <TextBlock Text="{DynamicResource T74}" Style="{DynamicResource Caption}" Margin="0,0,0,4"/>
                <TextBox x:Name="NativeSearch" Width="222" Style="{DynamicResource SearchBox}" TextChanged="OnNativeFilter" AutomationProperties.Name="{DynamicResource T75}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,8">
                <TextBlock Text="{DynamicResource T88}" Style="{DynamicResource Caption}" Margin="0,0,0,4"/>
                <ComboBox x:Name="NativeCategory" Width="190" SelectionChanged="OnNativeFilter" AutomationProperties.Name="{DynamicResource T90}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,8">
                <TextBlock Text="{DynamicResource T419}" Style="{DynamicResource Caption}" Margin="0,0,0,4"/>
                <ComboBox x:Name="NativeRisk" Width="140" SelectionChanged="OnNativeFilter" AutomationProperties.Name="{DynamicResource T417}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource T177}" Style="{DynamicResource Caption}" Margin="0,0,0,4"/>
                <ComboBox x:Name="NativeScope" Width="195" SelectionChanged="OnNativeFilter" AutomationProperties.Name="{DynamicResource T178}"/>
            </StackPanel>
        </WrapPanel>
        <TextBlock x:Name="NativeSummary" Text="{DynamicResource T117}" Style="{DynamicResource Caption}" Margin="0,0,0,6"/>
        <DataGrid x:Name="NativeGrid" Height="245" SelectionChanged="OnNativeSelection" AutomationProperties.Name="{DynamicResource T347}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource T37}" Binding="{Binding Name}" Width="2*" MinWidth="190"/>
                <DataGridTextColumn Header="{DynamicResource T177}" Binding="{Binding Scope}" Width="145"/>
                <DataGridTextColumn Header="{DynamicResource T88}" Binding="{Binding Category}" Width="150"/>
                <DataGridTextColumn Header="{DynamicResource T419}" Binding="{Binding Risk}" Width="110"/>
                <DataGridTextColumn Header="{DynamicResource T172}" Binding="{Binding Eligibility}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{DynamicResource T150}" Style="{DynamicResource PaneTitle}" Margin="0,16,0,6"/>
        <TextBox x:Name="NativeDetails" Style="{StaticResource DebloatReadout}" Height="160" Text="{DynamicResource T429}"
                 AutomationProperties.Name="{DynamicResource T307}"/>
        <Button x:Name="NativePreviewButton" Content="{DynamicResource T470}" Style="{DynamicResource GhostButton}" IsEnabled="False"
                HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnNativePreview"/>
        <TextBox x:Name="NativePreview" Style="{StaticResource DebloatReadout}" Margin="0,8,0,0" Visibility="Collapsed"
                 AutomationProperties.Name="{DynamicResource T370}"/>
        <Expander x:Name="SyntheticSection" Header="{DynamicResource T86}" Foreground="{DynamicResource Text}" Margin="0,18,0,0">
        <StackPanel>
        <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource T441}" Foreground="{DynamicResource Warn}" FontSize="14" FontWeight="SemiBold" AutomationProperties.AutomationId="DebloatSyntheticBanner"/>
                <TextBlock Text="{DynamicResource T188}" Style="{DynamicResource Caption}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
            <local:DebloatRemovalView x:Name="RemovalPresentation"/>
        </Border>
        <WrapPanel Margin="0,16,0,6">
            <StackPanel Margin="0,0,12,10">
                <TextBlock Text="{DynamicResource T68}" Style="{DynamicResource Caption}" Margin="0,0,0,5"/>
                <TextBox x:Name="SearchText" Width="280" Style="{DynamicResource SearchBox}" TextChanged="OnFilterChanged" AutomationProperties.Name="{DynamicResource T69}" AutomationProperties.AutomationId="DebloatSearch"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,10">
                <TextBlock Text="{DynamicResource T212}" Style="{DynamicResource Caption}" Margin="0,0,0,5"/>
                <ComboBox x:Name="FilterCombo" Width="200" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{DynamicResource T209}" AutomationProperties.AutomationId="DebloatFilter"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Content="{DynamicResource T47}" Style="{DynamicResource GhostButton}" VerticalAlignment="Bottom" Margin="0,0,0,10" Click="OnRefresh" AutomationProperties.AutomationId="RefreshDebloat"/>
        </WrapPanel>
        <TextBlock Text="{DynamicResource T84}" Style="{DynamicResource PaneTitle}" Margin="0,18,0,4" AutomationProperties.AutomationId="DebloatCatalogTitle"/>
        <TextBlock Text="{DynamicResource T0}" Style="{DynamicResource Caption}" Margin="0,0,0,10"/>
        <TextBlock Text="{DynamicResource T272}" Style="{DynamicResource PaneTitle}" Margin="0,0,0,4" AutomationProperties.AutomationId="DebloatInventoryTitle"/>
        <TextBlock Text="{DynamicResource T334}" Style="{DynamicResource Caption}" Margin="0,0,0,8"/>
        <TextBlock x:Name="InventorySummary" Text="{DynamicResource T270}" Style="{DynamicResource Caption}" Margin="0,0,0,8"/>
        <DataGrid x:Name="InventoryGrid" Height="300" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="{DynamicResource T85}" AutomationProperties.AutomationId="DebloatInventory">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource T37}" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="{DynamicResource T171}" Binding="{Binding Publisher}" Width="180"/>
                <DataGridTextColumn Header="{DynamicResource T471}" Binding="{Binding Version}" Width="100"/>
                <DataGridTextColumn Header="{DynamicResource T88}" Binding="{Binding Category}" Width="120"/>
                <DataGridTextColumn Header="{DynamicResource T342}" Binding="{Binding Origin}" Width="170"/>
                <DataGridTextColumn Header="{DynamicResource T368}" Binding="{Binding State}" Width="250"/>
                <DataGridTextColumn Header="{DynamicResource T418}" Binding="{Binding Risk}" Width="115"/>
                <DataGridTextColumn Header="{DynamicResource T134}" Binding="{Binding Dependencies}" Width="140"/>
                <DataGridTextColumn Header="{DynamicResource T172}" Binding="{Binding Eligibility}" Width="280"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{DynamicResource T467}" Style="{DynamicResource FootNote}" Margin="0,6,0,0"/>
        <TextBlock Text="{DynamicResource T38}" Style="{DynamicResource PaneTitle}" Margin="0,20,0,8"/>
        <TextBox x:Name="DetailsText" Style="{StaticResource DebloatReadout}" Text="{DynamicResource T426}" AutomationProperties.Name="{DynamicResource T254}" AutomationProperties.AutomationId="DebloatDetails"/>
        <TextBlock Text="{DynamicResource T366}" Style="{DynamicResource PaneTitle}" Margin="0,20,0,8"/>
        <WrapPanel>
            <StackPanel Margin="0,0,12,10">
                <TextBlock Text="{DynamicResource T92}" Style="{DynamicResource Caption}" Margin="0,0,0,5"/>
                <ComboBox x:Name="ScenarioCombo" Width="280" DisplayMemberPath="Label" SelectionChanged="OnPlanInputChanged" AutomationProperties.Name="{DynamicResource T92}" AutomationProperties.AutomationId="DebloatScenario"/>
            </StackPanel>
            <Button x:Name="PrepareButton" Content="{DynamicResource T365}" Style="{DynamicResource GhostButton}" VerticalAlignment="Bottom" Margin="0,0,0,10" IsEnabled="False" Click="OnPrepare" AutomationProperties.AutomationId="PrepareDebloat"/>
        </WrapPanel>
        <CheckBox x:Name="MediumReviewCheck" Foreground="{DynamicResource Text}" Content="{DynamicResource T415}" Checked="OnPlanInputChanged" Unchecked="OnPlanInputChanged" Margin="0,0,0,12" AutomationProperties.Name="{DynamicResource T111}" AutomationProperties.AutomationId="DebloatMediumReview"/>
        <TextBox x:Name="PlanText" Style="{StaticResource DebloatReadout}" Height="250" Text="{DynamicResource T367}" AutomationProperties.Name="{DynamicResource T359}" AutomationProperties.AutomationId="DebloatPlan"/>
        <TextBlock x:Name="ConfirmationHint" Text="{DynamicResource T3}" Style="{DynamicResource Caption}" Margin="0,12,0,6" AutomationProperties.AutomationId="DebloatConfirmationHint"/>
        <WrapPanel>
            <TextBox x:Name="ConfirmationText" Width="400" Height="38" Padding="12,8" IsReadOnly="False" TextWrapping="NoWrap" AcceptsReturn="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Margin="0,0,10,10" TextChanged="OnConfirmationChanged" IsEnabled="False" AutomationProperties.Name="{DynamicResource T161}" AutomationProperties.AutomationId="DebloatConfirmation"/>
            <Button x:Name="ExecuteButton" Content="{DynamicResource T62}" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,10" IsEnabled="False" Click="OnExecute" AutomationProperties.AutomationId="ExecuteDebloatSynthetic"/>
            <Button x:Name="CancelButton" Content="{DynamicResource T79}" Margin="0,0,0,10" IsEnabled="False" Click="OnCancel" AutomationProperties.AutomationId="CancelDebloat"/>
        </WrapPanel>
        <ProgressBar x:Name="BusyProgress" Height="4" Visibility="Collapsed" IsIndeterminate="True" AutomationProperties.Name="{DynamicResource T337}"/>
        <TextBlock x:Name="StatusText" Text="{DynamicResource T442}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="DebloatStatus"/>
        </StackPanel>
        </Expander>
        <DockPanel Margin="0,22,0,8" LastChildFill="False">
            <TextBlock Text="{DynamicResource T231}" Style="{DynamicResource PaneTitle}" VerticalAlignment="Center"/>
            <Button x:Name="OpenRecoveryButton" Content="{DynamicResource T10}" DockPanel.Dock="Right" Style="{DynamicResource GhostButton}"
                    Margin="8,0,0,0" Click="OnOpenRecovery"/>
        </DockPanel>
        <TextBlock x:Name="HistorySummary" Style="{DynamicResource Caption}" Margin="0,0,0,8"/>
        <ListBox x:Name="HistoryList" Height="180" SelectionMode="Single" DisplayMemberPath="Label" SelectionChanged="OnHistorySelected" AutomationProperties.Name="{DynamicResource T246}" AutomationProperties.AutomationId="DebloatHistory"/>
        <TextBlock x:Name="HistoryWarnings" Foreground="{DynamicResource Warn}" Margin="0,6,0,0" AutomationProperties.AutomationId="DebloatHistoryWarnings"/>
        <TextBox x:Name="HistoryDetails" Style="{StaticResource DebloatReadout}" Height="190" Margin="0,8,0,0" Text="{DynamicResource T433}" AutomationProperties.Name="{DynamicResource T148}" AutomationProperties.AutomationId="DebloatHistoryDetails"/>
        <TextBlock Text="{DynamicResource T394}" Style="{DynamicResource PaneTitle}" Margin="0,20,0,8"/>
        <TextBlock x:Name="ReinstallText" Text="{DynamicResource T427}" AutomationProperties.AutomationId="DebloatReinstallInformation"/>
        <TextBlock Text="{DynamicResource T395}" Foreground="{DynamicResource Warn}" Margin="0,8,0,0"/>
        <TextBlock Text="{DynamicResource T176}" Style="{DynamicResource FootNote}" Margin="0,20,0,0"/>
        <TextBlock Text="{DynamicResource T389}" Style="{DynamicResource FootNote}" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>
