<UserControl x:Class="SentinelCore.App.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SentinelCore.App"
             FontFamily="Segoe UI" Foreground="{DynamicResource Text}"
             Loaded="OnLoaded" Unloaded="OnUnloaded"
             AutomationProperties.AutomationId="DebloatView" AutomationProperties.Name="Debloat simulado">
    <UserControl.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource Surface}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Sidebar}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DebloatReadout" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Height" Value="220"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Debloat — catálogo, inventário e simulação" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Selecione um aplicativo por vez. Catálogo documental e inventário sintético são apresentados separadamente." Style="{DynamicResource PageSubtitle}"/>
        <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="SIMULAÇÃO — NENHUM APLICATIVO REAL SERÁ REMOVIDO." Foreground="{DynamicResource Warn}" FontSize="14" FontWeight="SemiBold" AutomationProperties.AutomationId="DebloatSyntheticBanner"/>
                <TextBlock Text="Nenhum pacote real é consultado. Execução real indisponível; classificação documental não comprova segurança no seu Windows." Style="{DynamicResource Caption}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Inventário nativo Appx/MSIX — não habilitado" Style="{DynamicResource PaneTitle}" AutomationProperties.AutomationId="DebloatNativeInventoryTitle"/>
                <TextBlock x:Name="NativeInventoryStatus" Text="Adaptador nativo implementado e compilável, mas não composto nesta versão. Nenhuma consulta a pacotes reais, desinstalação ou elevação é executada." Style="{DynamicResource Caption}" Margin="0,6,0,0" AutomationProperties.AutomationId="DebloatNativeInventoryStatus"/>
                <TextBlock Text="Estados distintos: consulta não executada; concluída sem resultados; parcial; negada; interrompida; falha de enumeração; indisponível. A ausência só é afirmada após consulta completa; observação parcial ou indisponível nunca confirma ausência." Style="{DynamicResource FootNote}" Margin="0,6,0,0" AutomationProperties.AutomationId="DebloatNativeInventoryStates"/>
            </StackPanel>
        </Border>
        <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
            <local:DebloatRemovalView x:Name="RemovalPresentation"/>
        </Border>
        <WrapPanel Margin="0,16,0,6">
            <StackPanel Margin="0,0,12,10">
                <TextBlock Text="Buscar aplicativo" Style="{DynamicResource Caption}" Margin="0,0,0,5"/>
                <TextBox x:Name="SearchText" Width="280" Style="{DynamicResource SearchBox}" TextChanged="OnFilterChanged" AutomationProperties.Name="Buscar aplicativo sintético" AutomationProperties.AutomationId="DebloatSearch"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,10">
                <TextBlock Text="Filtro" Style="{DynamicResource Caption}" Margin="0,0,0,5"/>
                <ComboBox x:Name="FilterCombo" Width="200" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Filtrar inventário sintético" AutomationProperties.AutomationId="DebloatFilter"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Content="Atualizar inventário sintético" Style="{DynamicResource GhostButton}" VerticalAlignment="Bottom" Margin="0,0,0,10" Click="OnRefresh" AutomationProperties.AutomationId="RefreshDebloat"/>
        </WrapPanel>
        <TextBlock Text="Catálogo de aplicativos" Style="{DynamicResource PaneTitle}" Margin="0,18,0,4" AutomationProperties.AutomationId="DebloatCatalogTitle"/>
        <TextBlock Text="162 entradas documentais. Estar no catálogo não comprova presença nem ausência neste computador." Style="{DynamicResource Caption}" Margin="0,0,0,10"/>
        <TextBlock Text="Inventário de aplicativos" Style="{DynamicResource PaneTitle}" Margin="0,0,0,4" AutomationProperties.AutomationId="DebloatInventoryTitle"/>
        <TextBlock Text="Observações da fixture sintética. Nenhuma consulta a pacotes reais do Windows é realizada." Style="{DynamicResource Caption}" Margin="0,0,0,8"/>
        <TextBlock x:Name="InventorySummary" Text="Inventário ainda não carregado." Style="{DynamicResource Caption}" Margin="0,0,0,8"/>
        <DataGrid x:Name="InventoryGrid" Height="300" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Catálogo e inventário sintético de aplicativos" AutomationProperties.AutomationId="DebloatInventory">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Aplicativo" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Editor" Binding="{Binding Publisher}" Width="180"/>
                <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="100"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="120"/>
                <DataGridTextColumn Header="Origem do registro" Binding="{Binding Origin}" Width="170"/>
                <DataGridTextColumn Header="Presença no inventário" Binding="{Binding State}" Width="250"/>
                <DataGridTextColumn Header="Risco efetivo" Binding="{Binding Risk}" Width="115"/>
                <DataGridTextColumn Header="Dependências" Binding="{Binding Dependencies}" Width="140"/>
                <DataGridTextColumn Header="Elegibilidade" Binding="{Binding Eligibility}" Width="280"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Use a rolagem horizontal para consultar todas as colunas. Selecione uma linha para abrir os detalhes." Style="{DynamicResource FootNote}" Margin="0,6,0,0"/>
        <TextBlock Text="Aplicativo selecionado" Style="{DynamicResource PaneTitle}" Margin="0,20,0,8"/>
        <TextBox x:Name="DetailsText" Style="{StaticResource DebloatReadout}" Text="Selecione um aplicativo no inventário sintético." AutomationProperties.Name="Identidade, riscos e limitações do aplicativo" AutomationProperties.AutomationId="DebloatDetails"/>
        <TextBlock Text="Preparar simulação individual" Style="{DynamicResource PaneTitle}" Margin="0,20,0,8"/>
        <WrapPanel>
            <StackPanel Margin="0,0,12,10">
                <TextBlock Text="Cenário sintético" Style="{DynamicResource Caption}" Margin="0,0,0,5"/>
                <ComboBox x:Name="ScenarioCombo" Width="280" DisplayMemberPath="Label" SelectionChanged="OnPlanInputChanged" AutomationProperties.Name="Cenário sintético" AutomationProperties.AutomationId="DebloatScenario"/>
            </StackPanel>
            <Button x:Name="PrepareButton" Content="Preparar plano simulado" Style="{DynamicResource GhostButton}" VerticalAlignment="Bottom" Margin="0,0,0,10" IsEnabled="False" Click="OnPrepare" AutomationProperties.AutomationId="PrepareDebloat"/>
        </WrapPanel>
        <CheckBox x:Name="MediumReviewCheck" Foreground="{DynamicResource Text}" Content="Revisei riscos, consequências e limites deste aplicativo de risco médio." Checked="OnPlanInputChanged" Unchecked="OnPlanInputChanged" Margin="0,0,0,12" AutomationProperties.Name="Confirmar revisão individual de risco médio" AutomationProperties.AutomationId="DebloatMediumReview"/>
        <TextBox x:Name="PlanText" Style="{StaticResource DebloatReadout}" Height="250" Text="Prepare um plano após revisar os detalhes. Alterações de aplicativo, cenário ou revisão invalidam o plano." AutomationProperties.Name="Plano simulado de Debloat" AutomationProperties.AutomationId="DebloatPlan"/>
        <TextBlock x:Name="ConfirmationHint" Text="A confirmação exata será exibida após preparar um plano elegível." Style="{DynamicResource Caption}" Margin="0,12,0,6" AutomationProperties.AutomationId="DebloatConfirmationHint"/>
        <WrapPanel>
            <TextBox x:Name="ConfirmationText" Width="400" Height="38" Padding="12,8" IsReadOnly="False" TextWrapping="NoWrap" AcceptsReturn="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Margin="0,0,10,10" TextChanged="OnConfirmationChanged" IsEnabled="False" AutomationProperties.Name="Digite a confirmação exata do plano simulado" AutomationProperties.AutomationId="DebloatConfirmation"/>
            <Button x:Name="ExecuteButton" Content="Autorizar e executar simulação" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,10" IsEnabled="False" Click="OnExecute" AutomationProperties.AutomationId="ExecuteDebloatSynthetic"/>
            <Button x:Name="CancelButton" Content="Cancelar" Margin="0,0,0,10" IsEnabled="False" Click="OnCancel" AutomationProperties.AutomationId="CancelDebloat"/>
        </WrapPanel>
        <ProgressBar x:Name="BusyProgress" Height="4" Visibility="Collapsed" IsIndeterminate="True" AutomationProperties.Name="Operação sintética em andamento"/>
        <TextBlock x:Name="StatusText" Text="Somente fixtures sintéticas. Nenhum aplicativo real é consultado ou removido." Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="DebloatStatus"/>
        <TextBlock Text="Histórico de simulações" Style="{DynamicResource PaneTitle}" Margin="0,22,0,8"/>
        <TextBlock x:Name="HistorySummary" Style="{DynamicResource Caption}" Margin="0,0,0,8"/>
        <ListBox x:Name="HistoryList" Height="180" SelectionMode="Single" DisplayMemberPath="Label" SelectionChanged="OnHistorySelected" AutomationProperties.Name="Histórico local de simulações de Debloat" AutomationProperties.AutomationId="DebloatHistory"/>
        <TextBlock x:Name="HistoryWarnings" Foreground="{DynamicResource Warn}" Margin="0,6,0,0" AutomationProperties.AutomationId="DebloatHistoryWarnings"/>
        <TextBox x:Name="HistoryDetails" Style="{StaticResource DebloatReadout}" Height="190" Margin="0,8,0,0" Text="Selecione uma simulação para consultar identidade, estado e limitações persistidas." AutomationProperties.Name="Detalhes da simulação histórica" AutomationProperties.AutomationId="DebloatHistoryDetails"/>
        <TextBlock Text="Reinstalação — informação documental" Style="{DynamicResource PaneTitle}" Margin="0,20,0,8"/>
        <TextBlock x:Name="ReinstallText" Text="Selecione um aplicativo ou registro do histórico para consultar as informações disponíveis." AutomationProperties.AutomationId="DebloatReinstallInformation"/>
        <TextBlock Text="Reinstalação não equivale a rollback. Dados, preferências, licenças, contas e integrações não possuem recuperação garantida." Foreground="{DynamicResource Warn}" Margin="0,8,0,0"/>
        <TextBlock Text="Entradas do catálogo sem observação de inventário aparecem como “Não verificado — inventário real indisponível”. Nenhuma linha afirma ausência sem consulta efetiva ao Windows." Style="{DynamicResource FootNote}" Margin="0,20,0,0"/>
        <TextBlock Text="Referência: Win11Debloat, Raphire, licença MIT. Nenhum script upstream é executado. Aviso integral em THIRD-PARTY-NOTICES.md." Style="{DynamicResource FootNote}" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>
