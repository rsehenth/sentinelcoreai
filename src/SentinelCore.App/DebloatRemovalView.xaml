<UserControl x:Class="SentinelCore.App.DebloatRemovalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="DebloatRemovalPresentation">
    <UserControl.Resources>
        <Style x:Key="RemovalReadout" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxHeight" Value="180"/>
            <Setter Property="Margin" Value="0,6,0,12"/>
        </Style>
    </UserControl.Resources>
    <Expander Header="{DynamicResource T403}" Foreground="{DynamicResource Text}"
              AutomationProperties.AutomationId="DebloatRemovalDetails">
        <StackPanel Margin="0,12,0,0">
            <TextBlock Text="{DynamicResource T441}" Foreground="{DynamicResource Warn}" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource T358}" Style="{DynamicResource PaneTitle}"/>
            <TextBox Text="{Binding Plan, Mode=OneWay}" Style="{StaticResource RemovalReadout}" AutomationProperties.Name="{DynamicResource T360}"/>
            <TextBlock Text="{DynamicResource T135}" Style="{DynamicResource PaneTitle}"/>
            <TextBox Text="{Binding Dependencies, Mode=OneWay}" Style="{StaticResource RemovalReadout}" AutomationProperties.Name="{DynamicResource T136}"/>
            <TextBlock Text="{DynamicResource T420}" Style="{DynamicResource PaneTitle}"/>
            <TextBox Text="{Binding Risks, Mode=OneWay}" Style="{StaticResource RemovalReadout}" AutomationProperties.Name="{DynamicResource T421}"/>
            <TextBlock Text="{DynamicResource T58}" Style="{DynamicResource PaneTitle}"/>
            <TextBox Text="{Binding Authorization, Mode=OneWay}" Style="{StaticResource RemovalReadout}" AutomationProperties.Name="{DynamicResource T59}"/>
            <TextBlock Text="{DynamicResource T183}" Style="{DynamicResource PaneTitle}"/>
            <TextBox Text="{Binding Progress, Mode=OneWay}" Style="{StaticResource RemovalReadout}" AutomationProperties.Name="{DynamicResource T374}"/>
            <TextBlock Text="{DynamicResource T410}" Style="{DynamicResource PaneTitle}"/>
            <TextBox Text="{Binding Result, Mode=OneWay}" Style="{StaticResource RemovalReadout}" AutomationProperties.Name="{DynamicResource T411}"/>
            <TextBlock Text="{DynamicResource T226}" Style="{DynamicResource PaneTitle}"/>
            <TextBox Text="{Binding History, Mode=OneWay}" Style="{StaticResource RemovalReadout}" AutomationProperties.Name="{DynamicResource T247}"/>
            <TextBlock Text="{DynamicResource T290}" Style="{DynamicResource PaneTitle}"/>
            <TextBox Text="{Binding Limitations, Mode=OneWay}" Style="{StaticResource RemovalReadout}" AutomationProperties.Name="{DynamicResource T291}"/>
            <TextBox Text="{Binding Reinstallation, Mode=OneWay}" Style="{StaticResource RemovalReadout}" AutomationProperties.Name="{DynamicResource T396}"/>
        </StackPanel>
    </Expander>
</UserControl>
