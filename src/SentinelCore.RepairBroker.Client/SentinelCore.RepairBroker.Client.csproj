<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Import Project="../../artifacts/packaging/repair-broker/ApprovedRepairBroker.props"
          Condition="Exists('../../artifacts/packaging/repair-broker/ApprovedRepairBroker.props')" />
  <ItemGroup>
    <ProjectReference Include="../SentinelCore.Application/SentinelCore.Application.csproj" />
    <ProjectReference Include="../SentinelCore.Infrastructure.Repairs/SentinelCore.Infrastructure.Repairs.csproj" />
    <Compile Include="../SentinelCore.RepairBroker/BrokerProtocol.cs" Link="BrokerProtocol.cs" />
    <Compile Include="../SentinelCore.RepairBroker/BrokerWindows.cs" Link="BrokerWindows.cs" />
    <Compile Include="../SentinelCore.RepairBroker/NativeRepairPreflight.cs" Link="NativeRepairPreflight.cs" />
    <Compile Include="../SentinelCore.RepairBroker/BrokerLeaseModels.cs" Link="BrokerLeaseModels.cs" />
    <Compile Include="../SentinelCore.RepairBroker/NativeOutcome.cs" Link="NativeOutcome.cs" />
  </ItemGroup>
  <Target Name="GenerateApprovedBrokerPin" BeforeTargets="CoreCompile">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(SentinelCoreApprovedRepairBrokerSha256)', '^([0-9A-F]{64})?$'))"
           Text="Pin do broker deve ser vazio (recusa) ou SHA-256 aprovado com 64 dígitos hexadecimais maiúsculos." />
    <WriteLinesToFile File="$(IntermediateOutputPath)RepairBrokerImagePin.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="namespace SentinelCore.RepairBroker%3B internal static class BrokerImagePin { internal const string Value = &quot;$(SentinelCoreApprovedRepairBrokerSha256)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)RepairBrokerImagePin.g.cs" />
    </ItemGroup>
  </Target>
</Project>
