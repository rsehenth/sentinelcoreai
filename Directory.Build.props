<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.3.0-preview.8</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <NuGetLockFilePath Condition="'$(PublishSingleFile)' == 'true'">$(MSBuildProjectDirectory)/packages.single-file.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Distribuição: a execução real da T2A não é compilada. Só o build experimental de validação a habilita. -->
    <SentinelCoreRealTweaks Condition="'$(SentinelCoreRealTweaks)' == ''">false</SentinelCoreRealTweaks>
    <!-- Gate independente do R1. Mesmo verdadeiro, a R1 não compõe executor real nesta fase. -->
    <SentinelCoreRealRepairs Condition="'$(SentinelCoreRealRepairs)' == ''">false</SentinelCoreRealRepairs>
    <!-- T3 independente: nenhum executor real é implementado, mesmo se esta propriedade for fornecida. -->
    <SentinelCoreRealDebloat Condition="'$(SentinelCoreRealDebloat)' == ''">false</SentinelCoreRealDebloat>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SentinelCoreRealTweaks)' == 'true'">
    <DefineConstants>$(DefineConstants);SENTINELCORE_REAL_TWEAKS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SentinelCoreRealRepairs)' == 'true'">
    <DefineConstants>$(DefineConstants);SENTINELCORE_REAL_REPAIRS</DefineConstants>
  </PropertyGroup>
</Project>
